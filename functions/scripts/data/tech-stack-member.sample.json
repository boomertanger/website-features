  "tours": {
    "gameplay": [
      "The game runs on the Gaming PC and shows on the G7. Its sound goes to the L-8 over an audio cable.",
      "OBS on the Gaming PC sends a clean copy of the game out over HDMI to the Elgato HD60X.",
      "The HD60X hands the feed to the Streaming PC over USB. Streamlabs layers the cams, alerts and scenes on top.",
      "The Streaming PC encodes once, sends the stream to Twitch and YouTube at the same time, and records a copy."
    ],
    "tiktok": [
      "TikTok has its own cams: the Link 2 face cam and the Link 2C shoulder cam, both on the Gaming PC.",
      "TikTok LIVE Studio runs on the Gaming PC's second G7, building the vertical layout.",
      "The Gaming PC streams TikTok itself. The Streaming PC is Boomer's older gaming PC and can't encode all three streams, so TikTok's runs here."
    ],
    "voice": [
      "The SM7dB lands on input 2 of the L-8 over XLR.",
      "In VR, the Quest’s sound travels to the L-8 over the Sennheiser wireless set: transmitter in the headset, receiver in the mixer.",
      "The L-8 mixes the mic, VR sound and sound pads. Boomer hears the same mix in the NDH 20s.",
      "The L-8's master out splits in two. One side goes into the Streaming PC, ready for Streamlabs.",
      "The other side goes into the Gaming PC, so the voice reaches TikTok too.",
      "Streamlabs puts the voice on the stream, matched to the cams."
    ],
    "cams": [
      "Three cams go to the Streaming PC: the Link face cam, the Brio shoulder cam and the C920x skipper cam.",
      "When the cams switch on, the Litra Glows follow on their own, and the Neo lights the skipper shot.",
      "Each cam is a source in Streamlabs, switched from the Stream Deck."
    ]
  },
