# Function params (firebase-functions/params defineString). Public values only:
# secrets go in Secret Manager (firebase functions:secrets:set NAME --project <alias>).
# Twitch app client ID (public): lib/accounts/index.js, twitchAuth.
TWITCH_CLIENT_ID=59qwrarfotu1bcpzrbc5w6ksw0v6yb
# Growth collector (lib/growth, docs/specs/growth-collector.md). Public values.
TWITCH_LOGIN=boomertanger
YOUTUBE_CHANNEL_ID=UCM3E9VJ9nmXE0sKDavHblFA
# TikTok Login Kit client key: empty until TikTok approves the app (TikTok stays off).
TIKTOK_CLIENT_KEY=
# YouTube OAuth client ID (public; lib/youtube, Scream Planner part 8). The client SECRET is a secret: firebase functions:secrets:set YOUTUBE_CLIENT_SECRET --project staging
YOUTUBE_CLIENT_ID=1046602786327-5bf42afv12sr2p8a0f286959lj1v9gm3.apps.googleusercontent.com
# Hotline Boom email (lib/hotline/mail.js). "on" binds the RESEND_API_KEY secret to contactSend and contactReply: set it only once that secret
# exists and the Resend domain is verified (Boom Alerts part 6). Off: replies fall back to "Open in my email" in /admin/inbox.
HOTLINE_EMAIL=off
