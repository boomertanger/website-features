rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A status change and its history entry always travel together:
    // statusHistory may grow (by exactly one entry) only when status really
    // changes, and status may change only with that entry. Rejects a "save"
    // whose new status equals the current one (e.g. a double-click), so a
    // duplicate status entry can't be written. Priority / duplicateOf-only
    // saves leave both untouched and still pass. The one other way history
    // may grow is an admin note on its own (isNoteOnlyEntry).
    function isConsistentStatusChange() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeHistory = before.get('statusHistory', []);
      let afterHistory = after.get('statusHistory', []);
      return (after.status == before.status && afterHistory == beforeHistory)
        || (after.status != before.status && afterHistory.size() == beforeHistory.size() + 1)
        || isNoteOnlyEntry(before, after, beforeHistory, afterHistory);
    }

    // A note saved without a status change: status and statusChangedAt stay
    // put (Cloud Stash cleanup rules age off statusChangedAt), the existing
    // history is kept as is, and exactly one entry is appended with only
    // { kind: "note", note (1-500 chars, the note field's limit), changedBy,
    // changedAt }.
    function isNoteOnlyEntry(before, after, beforeHistory, afterHistory) {
      let n = beforeHistory.size();
      return after.status == before.status
        && after.get('statusChangedAt', null) == before.get('statusChangedAt', null)
        && afterHistory.size() == n + 1
        && afterHistory[0:n] == beforeHistory
        && afterHistory[n] is map
        && afterHistory[n].keys().hasOnly(['kind', 'note', 'changedBy', 'changedAt'])
        && afterHistory[n].kind == 'note'
        && afterHistory[n].note is string
        && afterHistory[n].note.size() >= 1
        && afterHistory[n].note.size() <= 500
        && afterHistory[n].changedBy is string
        && afterHistory[n].changedAt is string;
    }

    // An admin panel save must actually change one of the fields the panel
    // manages; a write that changes nothing (or only updatedAt) is refused.
    function adminPanelChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // editedAt / editCount are set ONLY by the adminEditItem Cloud Function
    // (Admin SDK, bypasses these rules). No browser write may set or change
    // them, so the public "Edited by an admin" note can't be forged, and
    // content fields only change through that function (which always writes
    // an adminLog entry).
    function hasNoEditMarkers() {
      return !request.resource.data.keys().hasAny(['editedAt', 'editCount']);
    }
    function keepsEditMarkers() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt', 'editCount']);
    }

    // Admin audit trail (docs/specs/admin-editing.md). Written only by Cloud
    // Functions via the Admin SDK; admins can read it; nobody writes from a
    // browser. Entries expire via a TTL policy on expireAt.
    match /adminLog/{entryId} {
      // isAdmin() is the legacy allowlist (admins/{uid}); hasSiteRole is the new site's admin role (the Feature Lab's Admin activity list, docs/specs/feature-lab.md §5); the owner is
      // named too (Cloud Stash's Activity tab, docs/specs/cloud-stash.md §7).
      allow read: if isAdmin() || isSiteOwner('boomertanger') || hasSiteRole('boomertanger', 'admin');
      allow write: if false;
    }

    // Admin settings (e.g. adminSettings/log { retentionDays }), edited by
    // hand in the Firebase console. Read by Cloud Functions via the Admin SDK.
    // New-site admins read these too (Cloud Stash's Limits and settings, docs/specs/cloud-stash.md §7); every write stays false (the stash callables write them).
    match /adminSettings/{docId} {
      allow read: if isAdmin() || isSiteOwner('boomertanger') || hasSiteRole('boomertanger', 'admin');
      allow write: if false;
    }

    // Written only by the syncAdminStatus Cloud Function via the Admin SDK,
    // which bypasses these rules entirely. Never touched directly by clients.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Managed by hand in the Firebase console (or the Admin SDK).
    // Existence of a doc, keyed by lowercase email, marks that email as admin.
    match /adminAllowlist/{email} {
      allow read, write: if false;
    }

    // A member may toggle their own vote (add/remove exactly one entry in
    // votes) without touching anything else. Note: like requesterId, the
    // voter's id isn't identity-verified — someone could vote under a
    // fabricated id, or from two browsers. Acceptable given the stakes;
    // this is not a fraud-proof tally, just a lightweight signal.
    function isSingleVoteToggle() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeVotes = before.get('votes', []);
      let afterVotes = after.get('votes', []);
      let added = afterVotes.toSet().difference(beforeVotes.toSet());
      let removed = beforeVotes.toSet().difference(afterVotes.toSet());
      return request.auth != null
        && after.title == before.title
        && after.description == before.description
        && after.status == before.status
        && after.priority == before.priority
        && after.requesterId == before.requesterId
        && after.requesterName == before.requesterName
        && after.statusHistory == before.statusHistory
        && after.createdAt == before.createdAt
        && after.get('commentCount', 0) == before.get('commentCount', 0)
        && ((added.size() == 1 && removed.size() == 0)
            || (added.size() == 0 && removed.size() == 1));
    }

    // Bumping the comment counter by exactly 1, and nothing else. Client
    // calls this right after a successful comment create; if it fails the
    // comment still exists, just undercounted — not identity-verified,
    // same tradeoff as voting.
    function isFeatureCommentCountBump() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && after.title == before.title
        && after.description == before.description
        && after.status == before.status
        && after.priority == before.priority
        && after.requesterId == before.requesterId
        && after.requesterName == before.requesterName
        && after.statusHistory == before.statusHistory
        && after.createdAt == before.createdAt
        && after.get('votes', []) == before.get('votes', [])
        && after.commentCount == before.get('commentCount', 0) + 1;
    }

    // Shared, append-only event log used across every feature on the
    // site (see functions/index.js) to back a future "Latest updates"
    // feed. Written ONLY by Cloud Functions via the Admin SDK, which
    // bypasses these rules entirely — "create" is deliberately false
    // here so no client (in-app or an outside browser console) can
    // write a fabricated public event. See functions/index.js for the
    // convention future features should follow to add their own events.
    match /activityLog/{eventId} {
      allow read: if request.auth != null;
      allow create, update: if false;
      allow delete: if isAdmin(); // moderation only
    }

    // ---------- Cloud Stash: shared external-storage tracking ----------
    // See /features/cloud-stash/README.md for the full contract.

    // Written ONLY by Cloud Functions (recordAssetCreated / the safe-delete
    // path in performAssetDeletion, functions/index.js) via the Admin SDK.
    // Never touched directly by clients, even admins — deletion must go
    // through the Cloudinary Admin API call first, which client code can't
    // safely be trusted to do (an interrupted client write could delete the
    // Firestore record while the file stays live in Cloudinary, or clear a
    // linked doc's field while the Cloudinary asset survives).
    // Reads: the legacy allowlist, the owner and new-site admins (Cloud Stash, docs/specs/cloud-stash.md §7).
    match /externalAssets/{assetId} {
      allow read: if isAdmin() || isSiteOwner('boomertanger') || hasSiteRole('boomertanger', 'admin');
      allow write: if false;
    }

    // Same reasoning: only the functions that create/delete assets should
    // ever move this counter, so client writes (even correct-looking ones)
    // are refused rather than trusted to stay in sync.
    match /storageUsage/{docId} {
      allow read: if isAdmin() || isSiteOwner('boomertanger') || hasSiteRole('boomertanger', 'admin');
      allow write: if false;
    }

    // Config only, no real data at stake — admins can edit these directly.
    // The scheduled cleanup function (functions/index.js) reads whatever is
    // enabled here and still deletes only via the shared safe-delete path.
    // create/update validate the new doc; delete gets its own line because
    // a delete has no request.resource (a combined "write" rule errored on
    // it, so admins could never delete a rule).
    // New-site admins READ rules here; the new page changes them only through the stash callables (the legacy isAdmin() writes below stay until launch).
    match /cleanupRules/{ruleId} {
      allow read: if isAdmin() || isSiteOwner('boomertanger') || hasSiteRole('boomertanger', 'admin');
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.feature is string
        && request.resource.data.collection is string
        && request.resource.data.matchField is string
        && request.resource.data.matchValue is string
        && request.resource.data.ageField is string
        && request.resource.data.ageThresholdDays is int
        && request.resource.data.ageThresholdDays > 0
        && request.resource.data.enabled is bool;
    }

    match /featureRequests/{requestId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.status == "submitted"
        && request.resource.data.priority == null
        && request.resource.data.requesterId is string
        && request.resource.data.requesterName is string
        && request.resource.data.votes == []
        && request.resource.data.commentCount == 0
        && hasNoEditMarkers();

      // Only a real, verified admin (see isAdmin()) can change anything
      // after creation, and only status/priority/history fields. Content
      // (title, description) is locked for everyone here; admins edit it
      // through the adminEditItem Cloud Function.
      allow update: if keepsEditMarkers() && ((isAdmin()
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.requesterName == resource.data.requesterName
        && isConsistentStatusChange()
        && adminPanelChanges(['status', 'priority', 'statusHistory']))
        || isSingleVoteToggle()
        || isFeatureCommentCountBump());

      // No client deletes, even for admins: deleteFeatureRequest (Cloud
      // Function, Admin SDK) is the only path, so a request's comments and
      // activityLog events always go with it.
      allow delete: if false;

      // Public comment thread. authorId, like requesterId, isn't
      // identity-verified — but isAdminAuthor IS checked against the
      // real isAdmin() status, since faking an "Admin" badge on a public
      // comment is a trust issue we can actually prevent here.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.authorId is string
          && request.resource.data.authorName is string
          && request.resource.data.isAdminAuthor is bool
          && (request.resource.data.isAdminAuthor == false || isAdmin());
        allow update, delete: if false;
      }
    }

    // A member may toggle their own "me too" (add/remove exactly their own
    // uid in meTooBy) without touching anything else. Unlike featureRequests'
    // isSingleVoteToggle, this checks the toggled id against request.auth.uid
    // directly — Bug Zapper's client uses the real Firebase Auth uid (not a
    // MemberSpace id) specifically so this can be verified server-side.
    function isMeTooToggle() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeSet = before.get('meTooBy', []);
      let afterSet = after.get('meTooBy', []);
      let added = afterSet.toSet().difference(beforeSet.toSet());
      let removed = beforeSet.toSet().difference(afterSet.toSet());
      return request.auth != null
        && after.title == before.title
        && after.page == before.page
        && after.whatHappened == before.whatHappened
        && after.expectedInstead == before.expectedInstead
        && after.stepsToReproduce == before.stepsToReproduce
        && after.severity == before.severity
        && after.priority == before.priority
        && after.status == before.status
        && after.duplicateOf == before.duplicateOf
        && after.get('screenshotUrl', null) == before.get('screenshotUrl', null)
        && after.reporterUid == before.reporterUid
        && after.reporterName == before.reporterName
        && after.createdAt == before.createdAt
        && after.get('statusChangedAt', null) == before.get('statusChangedAt', null)
        && after.get('statusHistory', []) == before.get('statusHistory', [])
        && after.get('commentCount', 0) == before.get('commentCount', 0)
        && ((added.size() == 1 && added.hasOnly([request.auth.uid]) && removed.size() == 0)
            || (removed.size() == 1 && removed.hasOnly([request.auth.uid]) && added.size() == 0));
    }

    function isBugCommentCountBump() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && (isAdmin() || request.auth.uid == before.reporterUid)
        && after.commentCount == before.get('commentCount', 0) + 1
        && after.title == before.title
        && after.page == before.page
        && after.whatHappened == before.whatHappened
        && after.expectedInstead == before.expectedInstead
        && after.stepsToReproduce == before.stepsToReproduce
        && after.severity == before.severity
        && after.priority == before.priority
        && after.status == before.status
        && after.duplicateOf == before.duplicateOf
        && after.get('screenshotUrl', null) == before.get('screenshotUrl', null)
        && after.reporterUid == before.reporterUid
        && after.reporterName == before.reporterName
        && after.createdAt == before.createdAt
        && after.meTooBy == before.meTooBy
        && after.get('statusChangedAt', null) == before.get('statusChangedAt', null)
        && after.get('statusHistory', []) == before.get('statusHistory', []);
    }

    match /bugReports/{reportId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 200
        && request.resource.data.page is string
        && request.resource.data.page.size() >= 1
        && request.resource.data.page.size() <= 300
        && request.resource.data.whatHappened is string
        && request.resource.data.whatHappened.size() >= 1
        && request.resource.data.whatHappened.size() <= 2000
        && request.resource.data.expectedInstead is string
        && request.resource.data.expectedInstead.size() <= 2000
        && request.resource.data.stepsToReproduce is string
        && request.resource.data.stepsToReproduce.size() <= 2000
        && request.resource.data.severity in ["Cosmetic", "Minor", "Major", "Critical"]
        && request.resource.data.priority == null
        && request.resource.data.status == "Open"
        && request.resource.data.duplicateOf == null
        && request.resource.data.screenshotUrl == null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.meTooBy == []
        && request.resource.data.commentCount == 0
        && request.resource.data.statusHistory is list
        && request.resource.data.statusHistory.size() == 1
        && request.resource.data.statusHistory[0].status == "Open"
        && request.resource.data.statusHistory[0].changedBy is string
        && request.resource.data.statusHistory[0].changedAt is string
        && hasNoEditMarkers();

      // Two disjoint ways to update: a member's own me-too toggle, or an
      // admin editing status/priority/duplicateOf. screenshotUrl is left out
      // of BOTH — it can only ever be set by recordBugScreenshot or
      // adminEditItem (Admin SDK, bypass these rules) or cleared by Cloud
      // Stash's safe-delete path, never directly by a client write. Content
      // fields are locked for everyone here; admins edit them through
      // adminEditItem. (screenshotUrl is read with get(): a Cloud Stash purge
      // deletes the field.)
      allow update: if keepsEditMarkers() && (isMeTooToggle()
        || isBugCommentCountBump()
        || (isAdmin()
            && request.resource.data.title == resource.data.title
            && request.resource.data.page == resource.data.page
            && request.resource.data.whatHappened == resource.data.whatHappened
            && request.resource.data.expectedInstead == resource.data.expectedInstead
            && request.resource.data.stepsToReproduce == resource.data.stepsToReproduce
            && request.resource.data.severity == resource.data.severity
            && request.resource.data.reporterUid == resource.data.reporterUid
            && request.resource.data.reporterName == resource.data.reporterName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.meTooBy == resource.data.meTooBy
            && request.resource.data.get('screenshotUrl', null) == resource.data.get('screenshotUrl', null)
            && request.resource.data.commentCount == resource.data.commentCount
            && isConsistentStatusChange()
            && adminPanelChanges(['status', 'priority', 'duplicateOf', 'statusHistory'])));

      match /comments/{commentId} {
        allow read: if request.auth != null
          && (isAdmin()
              || request.auth.uid == get(/databases/$(database)/documents/bugReports/$(reportId)).data.reporterUid);

        allow create: if request.auth != null
          && (isAdmin()
              || request.auth.uid == get(/databases/$(database)/documents/bugReports/$(reportId)).data.reporterUid)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.authorId is string
          && request.resource.data.authorName is string
          && request.resource.data.isAdminAuthor is bool
          && (request.resource.data.isAdminAuthor == false || isAdmin());

        allow update, delete: if false;
      }
    }

    // ---------- Accounts (docs/specs/accounts.md "Rules") ----------
    // Deny by default. Every document below is written ONLY by Cloud Functions
    // (functions/lib/accounts, Admin SDK); no client may write any of them.
    // Site roles come from the ID token's custom claims, mirrored from
    // sites/{siteId}/members/{uid}.roles: { roles: { boomertanger: ["admin"] } }.
    function hasSiteRole(siteId, role) {
      return request.auth != null
        && request.auth.token.get('roles', {}).get(siteId, []).hasAny([role]);
    }

    // Staff = mods and admins (the owner is an admin), from the same custom claims.
    function isSiteStaff(siteId) {
      return hasSiteRole(siteId, 'admin') || hasSiteRole(siteId, 'mod');
    }

    // Control Room (docs/specs/control-room.md §13): the owner (sites/{siteId}.ownerUid), and the owner or an A2 Overseer and up
    // (crewGrade is the server-written claim "A1" to "A3" on the admin track; an A1 Steward is not enough).
    function isSiteOwner(siteId) {
      return request.auth != null
        && get(/databases/$(database)/documents/sites/$(siteId)).data.ownerUid == request.auth.uid;
    }
    function isOwnerOrA2Plus(siteId) {
      return isSiteOwner(siteId)
        || (hasSiteRole(siteId, 'admin') && request.auth.token.get('crewGrade', '') in ['A2', 'A3']);
    }

    // Mod Machina (docs/specs/mod-machina.md): Watcher or above. crewGrade is a claim written by the server
    // (1-4 on the mod track, "A1"-"A3" on the admin track); admins pass through hasSiteRole.
    function isWatcherPlus(siteId) {
      return hasSiteRole(siteId, 'admin')
        || (hasSiteRole(siteId, 'mod') && request.auth.token.get('crewGrade', 0) is int && request.auth.token.get('crewGrade', 0) >= 2);
    }

    // A signed-up member: signed in and finished signup. The profile is only created when signup
    // completes (functions/lib/accounts), so it is the signal; a member doc can exist earlier.
    function isSignedUpMember(siteId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/sites/$(siteId)/profiles/$(request.auth.uid));
    }

    // Site settings (name, tagline, socials, modules, ownerUid): public.
    match /sites/{siteId} {
      allow read: if true;
      allow write: if false;

      // Site membership (roles, joinedAt): the member and site admins.
      match /members/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || hasSiteRole(siteId, 'admin'));
        allow write: if false;

        // Decisions on a member's own Game Vault adds and cover suggestions ("rejected: reason"). TTL: expireAt.
        match /vaultNotices/{id} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }
      }

      // Public profile (handle, display name, avatar, opted-in platform names; the Trophy
      // Room adds xp, level, rank, showcase, featuredBadge and persona).
      match /profiles/{uid} {
        allow read: if true;
        allow write: if false;

        // Trophy Room: the badges and trophies a member holds are public (reasons stay in the ledger).
        match /badges/{badgeId} {
          allow read: if true;
          allow write: if false;
        }
        match /trophies/{trophyId} {
          allow read: if true;
          allow write: if false;
        }
      }

      // ---------- Trophy Room (docs/specs/rewards.md §9) ----------
      // Written ONLY by Cloud Functions (functions/lib/rewards). The catalog is public; the
      // ledger is closed (members read their own history through myRewardHistory).
      match /badges/{badgeId} {
        allow read: if true;
        allow write: if false;
      }
      match /collections/{collectionId} {
        allow read: if true;
        allow write: if false;
      }
      match /rewardLedger/{key} {
        allow read, write: if false;
      }

      // ---------- Boom Arcade (docs/specs/arcade-step1.md §6) ----------
      // Written ONLY by Cloud Functions (functions/lib/arcade). Games, versions,
      // bests and boards are public (the footer's leaderboard is open to guests);
      // runs and counters are server only.
      match /games/{gameId} {
        allow read: if true;
        allow write: if false;

        match /versions/{v} {
          allow read: if true;
          allow write: if false;

          match /bests/{id} {
            allow read: if true;
            allow write: if false;
          }
          match /boards/{id} {
            allow read: if true;
            allow write: if false;
          }
          match /runs/{runId} {
            allow read, write: if false;
          }
          match /counters/{shard} {
            allow read, write: if false;
          }
        }
      }

      // startRun's hourly counts and the daily salt for visitor IP keys: server only.
      match /rateLimits/{key} {
        allow read, write: if false;
      }
      match /private/{docId} {
        allow read, write: if false;
      }

      // ---------- Growth collector (docs/specs/growth-collector.md) ----------
      // Written ONLY by Cloud Functions (functions/lib/growth). The daily history is
      // for site admins; the footer's summary (public/socials) is public. TikTok
      // tokens live in private/tiktokAuth (no client access, above).
      match /growthDaily/{day} {
        allow read: if hasSiteRole(siteId, 'admin');
        allow write: if false;
      }
      // Every public/ doc is public read EXCEPT public/goalTracker (the Goal Tracker's published plan),
      // which signed-up members read. One rule, not two: rules OR together, so a second match could
      // not narrow this one. public/goalTrackerTeaser stays public.
      match /public/{docId} {
        allow read: if docId != 'goalTracker' || isSignedUpMember(siteId);
        allow write: if false;
      }

      // ---------- Goal Tracker (docs/specs/goal-tracker.md §4) ----------
      // Written ONLY by Cloud Functions (functions/lib/goalTracker). The draft (config, items,
      // metrics and their history) is for site admins; members read the published snapshot.
      match /goalTracker/{docId} {
        allow read: if hasSiteRole(siteId, 'admin');
        allow write: if false;
      }
      match /goalItems/{itemId} {
        allow read: if hasSiteRole(siteId, 'admin');
        allow write: if false;
      }
      match /goalMetrics/{metricId} {
        allow read: if hasSiteRole(siteId, 'admin');
        allow write: if false;

        match /history/{day} {
          allow read: if hasSiteRole(siteId, 'admin');
          allow write: if false;
        }
      }

      // ---------- Game Vault (docs/specs/game-vault.md §4) ----------
      // Written ONLY by Cloud Functions (functions/lib/vault). Games are public unless hidden
      // (clients query with hidden == false; the summary doc public/vault, above, is what the
      // site reads). Staff see hidden games, each game's private/source, and the queue.
      match /vaultGames/{slug} {
        allow read: if resource.data.hidden == false || isSiteStaff(siteId);
        allow write: if false;

        match /private/{docId} {
          allow read: if isSiteStaff(siteId);
          allow write: if false;
        }
        // "I want this too": one doc per member, function-written, never read by clients.
        match /wants/{uid} {
          allow read, write: if false;
        }
      }
      // Duplicate keys, the lookup cache and the brakes: server only.
      match /vaultKeys/{key} {
        allow read, write: if false;
      }
      match /vaultCache/{id} {
        allow read, write: if false;
      }
      match /vaultLimits/{uid} {
        allow read, write: if false;
      }

      // ---------- Feature Lab (docs/specs/feature-lab.md §3, §5) ----------
      // Written ONLY by Cloud Functions (functions/lib/lab). Everyone reads the board: an idea unless it is hidden, a comment unless it or its idea is
      // hidden (clients query with hidden == false); staff read everything. Votes, the post tokens and everyone's vote marks are closed; a member
      // reads only their own marks. Every write is false.
      match /lab/main/ideas/{ideaId} {
        allow read: if resource.data.hidden == false || isSiteStaff(siteId);
        allow write: if false;

        match /comments/{commentId} {
          allow read: if (resource.data.hidden == false
              && get(/databases/$(database)/documents/sites/$(siteId)/lab/main/ideas/$(ideaId)).data.hidden == false)
            || isSiteStaff(siteId);
          allow write: if false;
        }
        match /votes/{uid} {
          allow read, write: if false;
        }
      }
      match /lab/main/myVotes/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /lab/main/submitTokens/{token} {
        allow read, write: if false;
      }

      // ---------- Bug Zapper (docs/specs/bug-zapper.md §3, §5) ----------
      // Written ONLY by Cloud Functions (functions/lib/bugs). A report is public unless it is private (a security or privacy problem) or hidden: its
      // reporter reads their own if it isn't hidden, staff read everything. A report's staff/info (device, screenshot record) and its thread are for the
      // reporter and staff only (a reply is also gone for the reporter once hidden). Clients query public reports with private == false and hidden == false,
      // a member's own with by.uid == their uid and hidden == false. "Bit me too" records, the members' own lists and the post tokens are closed (a member
      // reads only their own myMeToos). Every write is false.
      // ---------- Hotline Boom (docs/specs/hotline-boom.md §7) ----------
      // The settings doc is public (reply time and which lines are open; nothing private). Team-lane messages and their notes: the owner, or a
      // signed-in caller whose crewGrade claim is in hotline/main.inboxGrades (default A2, A3; mods never). Owner-lane messages and notes: the
      // owner only. stats: the owner; statsTeam: the owner and inbox admins. limits: nobody. Only functions write any of it.
      function isHotlineInbox(siteId) {
        return isSiteOwner(siteId)
          || (request.auth != null && request.auth.token.get('crewGrade', '') is string
              && request.auth.token.get('crewGrade', '') in get(/databases/$(database)/documents/sites/$(siteId)/hotline/main).data.get('inboxGrades', ['A2', 'A3']));
      }
      match /hotline/main {
        allow read: if true;
        allow write: if false;
      }
      match /hotline/main/teamMessages/{msgId} {
        allow read: if isHotlineInbox(siteId);
        allow write: if false;
        match /hotlineNotes/{noteId} {
          allow read: if isHotlineInbox(siteId);
          allow write: if false;
        }
      }
      match /hotline/main/ownerMessages/{msgId} {
        allow read: if isSiteOwner(siteId);
        allow write: if false;
        match /hotlineNotes/{noteId} {
          allow read: if isSiteOwner(siteId);
          allow write: if false;
        }
      }
      match /hotline/main/stats/{month} {
        allow read: if isSiteOwner(siteId);
        allow write: if false;
      }
      match /hotline/main/statsTeam/{month} {
        allow read: if isHotlineInbox(siteId);
        allow write: if false;
      }
      match /hotline/main/limits/{key} {
        allow read, write: if false;
      }

      match /bugs/main/reports/{reportId} {
        allow read: if (resource.data.hidden == false
            && (resource.data.private == false || (request.auth != null && request.auth.uid == resource.data.by.uid)))
          || isSiteStaff(siteId);
        allow write: if false;

        match /staff/{docId} {
          allow read: if isSiteStaff(siteId)
            || (request.auth != null
              && request.auth.uid == get(/databases/$(database)/documents/sites/$(siteId)/bugs/main/reports/$(reportId)).data.by.uid
              && get(/databases/$(database)/documents/sites/$(siteId)/bugs/main/reports/$(reportId)).data.hidden == false);
          allow write: if false;
        }
        match /thread/{replyId} {
          allow read: if isSiteStaff(siteId)
            || (request.auth != null
              && request.auth.uid == get(/databases/$(database)/documents/sites/$(siteId)/bugs/main/reports/$(reportId)).data.by.uid
              && get(/databases/$(database)/documents/sites/$(siteId)/bugs/main/reports/$(reportId)).data.hidden == false
              && resource.data.hidden == false);
          allow write: if false;
        }
        match /meToo/{uid} {
          allow read, write: if false;
        }
      }
      match /bugs/main/myMeToos/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /bugs/main/submitTokens/{token} {
        allow read, write: if false;
      }
      // The mod queue (adds and cover suggestions). The submitter's uid is in private/submitter: admins only.
      match /vaultQueue/{id} {
        allow read: if isSiteStaff(siteId);
        allow write: if false;

        match /private/{docId} {
          allow read: if hasSiteRole(siteId, 'admin');
          allow write: if false;
        }
      }
      // Staff-only reading (docs/specs/game-vault-how-it-works.md §3), e.g. the queue's mod guide
      // (vault-guide). Mods and admins read; only functions/scripts/seed-staff-doc.js writes.
      match /staffDocs/{docId} {
        allow read: if isSiteStaff(siteId);
        allow write: if false;
      }

      // ---------- Fun Factory (docs/specs/fun-factory.md §9) ----------
      // Everything lives under one container doc, factory/main (Firestore paths alternate
      // collection / document). Written ONLY by Cloud Functions (functions/lib/factory); no
      // client writes anywhere. A season and its chapters, campaigns and activities are public
      // only once the season is live or ended AND the node is revealed (the scheduler sets
      // revealed at its unlock time), so drafts and future chapters never reach a browser;
      // queries must filter on revealed == true. Progress and streaks: their member only.
      // Standings, boards and activity types: public; ideas: mods and admins. Events and hunts (the medals and
      // where they hide) are closed: pages get a hunt's medals for one path from factoryHuntMedals.
      match /factory/{rootId} {
        allow read, write: if false;

        match /seasons/{seasonId} {
          allow read: if resource.data.status in ['live', 'ended'] && resource.data.revealed == true;
          allow write: if false;

          function seasonPublic() {
            let s = get(/databases/$(database)/documents/sites/$(siteId)/factory/$(rootId)/seasons/$(seasonId)).data;
            return s.status in ['live', 'ended'] && s.revealed == true;
          }
          match /chapters/{chapterId} {
            allow read: if resource.data.revealed == true && seasonPublic();
            allow write: if false;
          }
          // A mod's addition waiting for an admin (approval pending or changes) is never revealed, and is hidden here too.
          match /campaigns/{campaignId} {
            allow read: if resource.data.revealed == true && !(resource.data.get('approval', 'approved') in ['pending', 'changes']) && seasonPublic();
            allow write: if false;
          }
          match /activities/{activityId} {
            allow read: if resource.data.revealed == true && !(resource.data.get('approval', 'approved') in ['pending', 'changes']) && seasonPublic();
            allow write: if false;
          }
          match /progress/{uid} {
            allow read: if request.auth != null && request.auth.uid == uid;
            allow write: if false;
          }
          match /standings/{uid} {
            allow read: if true;
            allow write: if false;
          }
          match /boards/{boardId} {
            allow read: if true;
            allow write: if false;
          }
          match /hunts/{huntId} {
            allow read, write: if false;
            match /medals/{medalId} {
              allow read, write: if false;
            }
          }
        }
        match /activityTypes/{typeId} {
          allow read: if true;
          allow write: if false;
        }
        match /streaks/{uid} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }
        // The idea library: mods and admins only (custom claims); admins edit through factoryIdeaSave.
        match /ideas/{ideaId} {
          allow read: if isSiteStaff(siteId);
          allow write: if false;
        }
        match /events/{key} {
          allow read, write: if false;
        }
        match /private/{docId} {
          allow read, write: if false;
        }
      }

      // ---------- Mod Machina (docs/specs/mod-machina.md §13) ----------
      // Everything lives under one container doc, crew/main (the settings doc; paths alternate collection /
      // document). Written ONLY by Cloud Functions (functions/lib/crew); no client writes anywhere.
      // Gears and referrals are closed: callables return what a page needs.
      match /crew/{rootId} {
        allow read: if isSiteStaff(siteId);
        allow write: if false;

        // The roster: crew read it (claims); the public part (grade, track, status) is mirrored to
        // profiles/{uid}.crew. The private record (reliability, strikes, notes): the member, admins and the owner.
        match /roster/{uid} {
          allow read: if isSiteStaff(siteId);
          allow write: if false;

          match /private/{docId} {
            allow read: if request.auth != null && (request.auth.uid == uid || hasSiteRole(siteId, 'admin'));
            allow write: if false;
          }
        }

        // The swap board (Mod Machina phase 3 part 1, docs/specs/mod-machina.md section 17a): seats dropped after publish, open until the stream starts. Crew read it; only functions write it.
        // (Handles only: no reliability data here.)
        // Duty records (Mod Machina phase 3 part 2): one per person per stream, crew/main/duties/{streamId}_{uid}. The person it is about, admins and the owner read it (the uid is a field, because a rule
        // can't take it out of the id); only functions write it.
        match /duties/{dutyId} {
          allow read: if request.auth != null && (resource.data.uid == request.auth.uid || hasSiteRole(siteId, 'admin') || isSiteOwner(siteId));
          allow write: if false;
        }

        // Crew notes (Mod Machina phase 3 part 4): the Mod Deck's 24-hour strip. Crew (mods and admins) and the owner read it; only crewNote / crewNoteDelete write it. TTL on expireAt.
        match /notes/{noteId} {
          allow read: if isSiteStaff(siteId) || isSiteOwner(siteId);
          allow write: if false;
        }

        match /swaps/{swapId} {
          allow read: if isSiteStaff(siteId);
          allow write: if false;
        }

        // HQ notices (Mod Machina phase 3 part 7): the member a notice is for reads it (the uid is a field), plus admins and the owner. Only functions write
        // (writeNotice, crewNoticeRead marks your own read). TTL on expireAt (30 days).
        match /notices/{noticeId} {
          allow read: if request.auth != null && (resource.data.uid == request.auth.uid || hasSiteRole(siteId, 'admin') || isSiteOwner(siteId));
          allow write: if false;
        }

        // Applications: the applicant reads their own (it carries only their band, never the score);
        // Watcher and above and admins read all; vouches follow; concerns are admins and owner only.
        match /applications/{appId} {
          allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isWatcherPlus(siteId));
          allow write: if false;

          match /vouches/{voucherUid} {
            allow read: if isWatcherPlus(siteId);
            allow write: if false;
          }
          match /concerns/{uid} {
            allow read: if hasSiteRole(siteId, 'admin');
            allow write: if false;
          }
          match /private/{docId} {
            allow read: if isWatcherPlus(siteId);
            allow write: if false;
          }
        }

        match /gears/{key} {
          allow read, write: if false;
        }
        match /boards/{boardId} {
          allow read: if true;
          allow write: if false;
        }
        match /tasks/{taskId} {
          allow read: if isSiteStaff(siteId);
          allow write: if false;
        }
        match /academyProgress/{uid} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }
        match /awards/{month} {
          allow read: if true;
          allow write: if false;

          match /votes/{uid} {
            allow read, write: if false;
          }
        }
        match /referrals/{newUid} {
          allow read, write: if false;
        }
        // The to-do list for /admin/crew: add or remove a platform moderator by hand ("Add @handle as a Twitch mod").
        match /todos/{todoId} {
          allow read: if hasSiteRole(siteId, 'admin');
          allow write: if false;
        }
      }

      // ---------- Scream Planner (docs/specs/scream-planner.md §4) ----------
      // Written ONLY by Cloud Functions (functions/lib/planner); no client writes anywhere.
      // planner/main (deadlines and defaults), its patterns, exceptions and to-dos: admins read.
      match /planner/{rootId} {
        allow read: if hasSiteRole(siteId, 'admin');
        allow write: if false;
        match /patterns/{id} { allow read: if hasSiteRole(siteId, 'admin'); allow write: if false; }
        match /exceptions/{id} { allow read: if hasSiteRole(siteId, 'admin'); allow write: if false; }
        match /todos/{id} { allow read: if hasSiteRole(siteId, 'admin'); allow write: if false; }
      }
      // The week (state, deadlines, hero, counts): crew (mods and admins) read. The ballot's counts and each
      // member's votes are closed: the public ballot is public/ballot and a member's own picks come from ballotMine.
      match /planWeeks/{week} {
        allow read: if isSiteStaff(siteId);
        allow write: if false;
        match /ballot/{slug} { allow read, write: if false; }
        match /votes/{uid} { allow read, write: if false; }
      }
      // The hand-off to the Notifications service: server only (TTL 30 days on expireAt).
      match /notifyOutbox/{id} {
        allow read, write: if false;
      }

      // ---------- The stream object (docs/specs/stream-object.md §4) ----------
      // Everyone reads a published stream (clients query with published == true); staff read
      // every stream and its private/* (the owner's draft). No client writes anywhere.
      match /streams/{streamId} {
        allow read: if resource.data.published == true || isSiteStaff(siteId);
        allow write: if false;

        // private/watch holds the YouTube event and video IDs (the unlisted backstage video among them): server
        // only. Rules from overlapping matches are OR-ed, so the exclusion lives in this one rule, not in a
        // separate deny match. The Control Room adds two more (docs/specs/control-room.md §13), again inside this one rule:
        // private/control holds the CURRENT check-in word, so only the owner and A2+ read it (never a mod); private/checklist
        // is the owner's own list: the owner's uid only (an A2 cannot read it). Everything else here (the draft) stays staff.
        // private/duty (Mod Machina phase 3 part 2) is the live duty state the Mod Deck reads: captainNow, who is on duty, prompts and room coverage. It never holds the check-in word,
        // so crew (mods and admins, any grade) and the owner read it. Only functions write it.
        match /private/{docId} {
          allow read: if (docId == 'control' && isOwnerOrA2Plus(siteId))
            || (docId == 'checklist' && isSiteOwner(siteId))
            || (docId == 'duty' && (isSiteStaff(siteId) || isSiteOwner(siteId)))
            || (docId != 'watch' && docId != 'control' && docId != 'checklist' && docId != 'duty' && isSiteStaff(siteId));
          allow write: if false;
        }

        // Flags to the owner (Mod Machina phase 3 part 5): the owner and admins read them; only liveFlag and liveFlagAck write. The flagger learns "Seen by Boomer" from private/duty.flagsSeen, so crew never read this.
        match /flags/{flagId} {
          allow read: if isSiteOwner(siteId) || hasSiteRole(siteId, 'admin');
          allow write: if false;
        }

        // Check-in presence: that member reads their own record ("What we recorded for this stream"), admins read all.
        // Written by streamCheckIn and the settle step only; it expires after 13 months (TTL on expireAt).
        match /presence/{uid} {
          allow read: if request.auth != null && (request.auth.uid == uid || hasSiteRole(siteId, 'admin'));
          allow write: if false;
        }
        // The 10 check-in counter shards (counts per beat and room): the owner and A2+. The stream view gets its numbers from
        // obsFeed with its key, not from these documents.
        match /counters/{shard} {
          allow read: if isOwnerOrA2Plus(siteId);
          allow write: if false;
        }
        // Recruit Rush (Mod Machina phase 3 part 6): one marker per member counted, so a retried trigger counts once. Server only
        // (it is keyed by uid); the count reaches the page through the shards and public/live. 30 days, TTL on expireAt.
        match /rushJoins/{uid} {
          allow read, write: if false;
        }

        // Scream Planner sign-ups (availability, seats, game request): crew (mods and admins) read; written by callables.
        // No reliability data lives here (it is not phase-2 data), so every mod can read every handle.
        match /signups/{uid} {
          allow read: if isSiteStaff(siteId);
          allow write: if false;
        }
      }

      // ---------- Control Room (docs/specs/control-room.md §13) ----------
      // live/main: settings, the look, and the stream view and deck key HASHES: the owner and A2+ read it. Written only by
      // Cloud Functions. live/main/private/checklistTemplates: the owner's uid only. live/main/wordLog (when each check-in
      // word was last used) is server only. What /live shows is public/live, covered by the public/{docId} rule above.
      match /live/{docId} {
        allow read: if isOwnerOrA2Plus(siteId);
        allow write: if false;

        match /private/{templateId} {
          allow read: if isSiteOwner(siteId);
          allow write: if false;
        }
        match /wordLog/{word} {
          allow read, write: if false;
        }
      }
    }

    // Account doc: only its owner reads it. Preferences change through the
    // updatePrefs callable, so there are no client writes at all. Birth month and
    // year live in private/age, which no client can read or write.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // Handle -> uid (unique handles): public so profiles can be looked up.
    match /handles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    // Platform account -> uid: server only.
    match /platformLinks/{linkId} {
      allow read, write: if false;
    }
  }
}
