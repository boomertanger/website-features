rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A status change and its history entry always travel together:
    // statusHistory may grow (by exactly one entry) only when status really
    // changes, and status may change only with that entry. Rejects a "save"
    // whose new status equals the current one (e.g. a double-click), so a
    // duplicate status entry can't be written. Priority / duplicateOf-only
    // saves leave both untouched and still pass. The one other way history
    // may grow is an admin note on its own (isNoteOnlyEntry).
    function isConsistentStatusChange() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeHistory = before.get('statusHistory', []);
      let afterHistory = after.get('statusHistory', []);
      return (after.status == before.status && afterHistory == beforeHistory)
        || (after.status != before.status && afterHistory.size() == beforeHistory.size() + 1)
        || isNoteOnlyEntry(before, after, beforeHistory, afterHistory);
    }

    // A note saved without a status change: status and statusChangedAt stay
    // put (Cloud Stash cleanup rules age off statusChangedAt), the existing
    // history is kept as is, and exactly one entry is appended with only
    // { kind: "note", note (1-500 chars, the note field's limit), changedBy,
    // changedAt }.
    function isNoteOnlyEntry(before, after, beforeHistory, afterHistory) {
      let n = beforeHistory.size();
      return after.status == before.status
        && after.get('statusChangedAt', null) == before.get('statusChangedAt', null)
        && afterHistory.size() == n + 1
        && afterHistory[0:n] == beforeHistory
        && afterHistory[n] is map
        && afterHistory[n].keys().hasOnly(['kind', 'note', 'changedBy', 'changedAt'])
        && afterHistory[n].kind == 'note'
        && afterHistory[n].note is string
        && afterHistory[n].note.size() >= 1
        && afterHistory[n].note.size() <= 500
        && afterHistory[n].changedBy is string
        && afterHistory[n].changedAt is string;
    }

    // An admin panel save must actually change one of the fields the panel
    // manages; a write that changes nothing (or only updatedAt) is refused.
    function adminPanelChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // editedAt / editCount are set ONLY by the adminEditItem Cloud Function
    // (Admin SDK, bypasses these rules). No browser write may set or change
    // them, so the public "Edited by an admin" note can't be forged, and
    // content fields only change through that function (which always writes
    // an adminLog entry).
    function hasNoEditMarkers() {
      return !request.resource.data.keys().hasAny(['editedAt', 'editCount']);
    }
    function keepsEditMarkers() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt', 'editCount']);
    }

    // Admin audit trail (docs/specs/admin-editing.md). Written only by Cloud
    // Functions via the Admin SDK; admins can read it; nobody writes from a
    // browser. Entries expire via a TTL policy on expireAt.
    match /adminLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin settings (e.g. adminSettings/log { retentionDays }), edited by
    // hand in the Firebase console. Read by Cloud Functions via the Admin SDK.
    match /adminSettings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Written only by the syncAdminStatus Cloud Function via the Admin SDK,
    // which bypasses these rules entirely. Never touched directly by clients.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Managed by hand in the Firebase console (or the Admin SDK).
    // Existence of a doc, keyed by lowercase email, marks that email as admin.
    match /adminAllowlist/{email} {
      allow read, write: if false;
    }

    // A member may toggle their own vote (add/remove exactly one entry in
    // votes) without touching anything else. Note: like requesterId, the
    // voter's id isn't identity-verified — someone could vote under a
    // fabricated id, or from two browsers. Acceptable given the stakes;
    // this is not a fraud-proof tally, just a lightweight signal.
    function isSingleVoteToggle() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeVotes = before.get('votes', []);
      let afterVotes = after.get('votes', []);
      let added = afterVotes.toSet().difference(beforeVotes.toSet());
      let removed = beforeVotes.toSet().difference(afterVotes.toSet());
      return request.auth != null
        && after.title == before.title
        && after.description == before.description
        && after.status == before.status
        && after.priority == before.priority
        && after.requesterId == before.requesterId
        && after.requesterName == before.requesterName
        && after.statusHistory == before.statusHistory
        && after.createdAt == before.createdAt
        && after.get('commentCount', 0) == before.get('commentCount', 0)
        && ((added.size() == 1 && removed.size() == 0)
            || (added.size() == 0 && removed.size() == 1));
    }

    // Bumping the comment counter by exactly 1, and nothing else. Client
    // calls this right after a successful comment create; if it fails the
    // comment still exists, just undercounted — not identity-verified,
    // same tradeoff as voting.
    function isFeatureCommentCountBump() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && after.title == before.title
        && after.description == before.description
        && after.status == before.status
        && after.priority == before.priority
        && after.requesterId == before.requesterId
        && after.requesterName == before.requesterName
        && after.statusHistory == before.statusHistory
        && after.createdAt == before.createdAt
        && after.get('votes', []) == before.get('votes', [])
        && after.commentCount == before.get('commentCount', 0) + 1;
    }

    // Shared, append-only event log used across every feature on the
    // site (see functions/index.js) to back a future "Latest updates"
    // feed. Written ONLY by Cloud Functions via the Admin SDK, which
    // bypasses these rules entirely — "create" is deliberately false
    // here so no client (in-app or an outside browser console) can
    // write a fabricated public event. See functions/index.js for the
    // convention future features should follow to add their own events.
    match /activityLog/{eventId} {
      allow read: if request.auth != null;
      allow create, update: if false;
      allow delete: if isAdmin(); // moderation only
    }

    // ---------- Cloud Stash: shared external-storage tracking ----------
    // See /features/cloud-stash/README.md for the full contract.

    // Written ONLY by Cloud Functions (recordAssetCreated / the safe-delete
    // path in performAssetDeletion, functions/index.js) via the Admin SDK.
    // Never touched directly by clients, even admins — deletion must go
    // through the Cloudinary Admin API call first, which client code can't
    // safely be trusted to do (an interrupted client write could delete the
    // Firestore record while the file stays live in Cloudinary, or clear a
    // linked doc's field while the Cloudinary asset survives).
    match /externalAssets/{assetId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Same reasoning: only the functions that create/delete assets should
    // ever move this counter, so client writes (even correct-looking ones)
    // are refused rather than trusted to stay in sync.
    match /storageUsage/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Config only, no real data at stake — admins can edit these directly.
    // The scheduled cleanup function (functions/index.js) reads whatever is
    // enabled here and still deletes only via the shared safe-delete path.
    // create/update validate the new doc; delete gets its own line because
    // a delete has no request.resource (a combined "write" rule errored on
    // it, so admins could never delete a rule).
    match /cleanupRules/{ruleId} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.feature is string
        && request.resource.data.collection is string
        && request.resource.data.matchField is string
        && request.resource.data.matchValue is string
        && request.resource.data.ageField is string
        && request.resource.data.ageThresholdDays is int
        && request.resource.data.ageThresholdDays > 0
        && request.resource.data.enabled is bool;
    }

    match /featureRequests/{requestId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.status == "submitted"
        && request.resource.data.priority == null
        && request.resource.data.requesterId is string
        && request.resource.data.requesterName is string
        && request.resource.data.votes == []
        && request.resource.data.commentCount == 0
        && hasNoEditMarkers();

      // Only a real, verified admin (see isAdmin()) can change anything
      // after creation, and only status/priority/history fields. Content
      // (title, description) is locked for everyone here; admins edit it
      // through the adminEditItem Cloud Function.
      allow update: if keepsEditMarkers() && ((isAdmin()
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.requesterName == resource.data.requesterName
        && isConsistentStatusChange()
        && adminPanelChanges(['status', 'priority', 'statusHistory']))
        || isSingleVoteToggle()
        || isFeatureCommentCountBump());

      // No client deletes, even for admins: deleteFeatureRequest (Cloud
      // Function, Admin SDK) is the only path, so a request's comments and
      // activityLog events always go with it.
      allow delete: if false;

      // Public comment thread. authorId, like requesterId, isn't
      // identity-verified — but isAdminAuthor IS checked against the
      // real isAdmin() status, since faking an "Admin" badge on a public
      // comment is a trust issue we can actually prevent here.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.authorId is string
          && request.resource.data.authorName is string
          && request.resource.data.isAdminAuthor is bool
          && (request.resource.data.isAdminAuthor == false || isAdmin());
        allow update, delete: if false;
      }
    }

    // A member may toggle their own "me too" (add/remove exactly their own
    // uid in meTooBy) without touching anything else. Unlike featureRequests'
    // isSingleVoteToggle, this checks the toggled id against request.auth.uid
    // directly — Bug Zapper's client uses the real Firebase Auth uid (not a
    // MemberSpace id) specifically so this can be verified server-side.
    function isMeTooToggle() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeSet = before.get('meTooBy', []);
      let afterSet = after.get('meTooBy', []);
      let added = afterSet.toSet().difference(beforeSet.toSet());
      let removed = beforeSet.toSet().difference(afterSet.toSet());
      return request.auth != null
        && after.title == before.title
        && after.page == before.page
        && after.whatHappened == before.whatHappened
        && after.expectedInstead == before.expectedInstead
        && after.stepsToReproduce == before.stepsToReproduce
        && after.severity == before.severity
        && after.priority == before.priority
        && after.status == before.status
        && after.duplicateOf == before.duplicateOf
        && after.get('screenshotUrl', null) == before.get('screenshotUrl', null)
        && after.reporterUid == before.reporterUid
        && after.reporterName == before.reporterName
        && after.createdAt == before.createdAt
        && after.get('statusChangedAt', null) == before.get('statusChangedAt', null)
        && after.get('statusHistory', []) == before.get('statusHistory', [])
        && after.get('commentCount', 0) == before.get('commentCount', 0)
        && ((added.size() == 1 && added.hasOnly([request.auth.uid]) && removed.size() == 0)
            || (removed.size() == 1 && removed.hasOnly([request.auth.uid]) && added.size() == 0));
    }

    function isBugCommentCountBump() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth != null
        && (isAdmin() || request.auth.uid == before.reporterUid)
        && after.commentCount == before.get('commentCount', 0) + 1
        && after.title == before.title
        && after.page == before.page
        && after.whatHappened == before.whatHappened
        && after.expectedInstead == before.expectedInstead
        && after.stepsToReproduce == before.stepsToReproduce
        && after.severity == before.severity
        && after.priority == before.priority
        && after.status == before.status
        && after.duplicateOf == before.duplicateOf
        && after.get('screenshotUrl', null) == before.get('screenshotUrl', null)
        && after.reporterUid == before.reporterUid
        && after.reporterName == before.reporterName
        && after.createdAt == before.createdAt
        && after.meTooBy == before.meTooBy
        && after.get('statusChangedAt', null) == before.get('statusChangedAt', null)
        && after.get('statusHistory', []) == before.get('statusHistory', []);
    }

    match /bugReports/{reportId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 200
        && request.resource.data.page is string
        && request.resource.data.page.size() >= 1
        && request.resource.data.page.size() <= 300
        && request.resource.data.whatHappened is string
        && request.resource.data.whatHappened.size() >= 1
        && request.resource.data.whatHappened.size() <= 2000
        && request.resource.data.expectedInstead is string
        && request.resource.data.expectedInstead.size() <= 2000
        && request.resource.data.stepsToReproduce is string
        && request.resource.data.stepsToReproduce.size() <= 2000
        && request.resource.data.severity in ["Cosmetic", "Minor", "Major", "Critical"]
        && request.resource.data.priority == null
        && request.resource.data.status == "Open"
        && request.resource.data.duplicateOf == null
        && request.resource.data.screenshotUrl == null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.meTooBy == []
        && request.resource.data.commentCount == 0
        && request.resource.data.statusHistory is list
        && request.resource.data.statusHistory.size() == 1
        && request.resource.data.statusHistory[0].status == "Open"
        && request.resource.data.statusHistory[0].changedBy is string
        && request.resource.data.statusHistory[0].changedAt is string
        && hasNoEditMarkers();

      // Two disjoint ways to update: a member's own me-too toggle, or an
      // admin editing status/priority/duplicateOf. screenshotUrl is left out
      // of BOTH — it can only ever be set by recordBugScreenshot or
      // adminEditItem (Admin SDK, bypass these rules) or cleared by Cloud
      // Stash's safe-delete path, never directly by a client write. Content
      // fields are locked for everyone here; admins edit them through
      // adminEditItem. (screenshotUrl is read with get(): a Cloud Stash purge
      // deletes the field.)
      allow update: if keepsEditMarkers() && (isMeTooToggle()
        || isBugCommentCountBump()
        || (isAdmin()
            && request.resource.data.title == resource.data.title
            && request.resource.data.page == resource.data.page
            && request.resource.data.whatHappened == resource.data.whatHappened
            && request.resource.data.expectedInstead == resource.data.expectedInstead
            && request.resource.data.stepsToReproduce == resource.data.stepsToReproduce
            && request.resource.data.severity == resource.data.severity
            && request.resource.data.reporterUid == resource.data.reporterUid
            && request.resource.data.reporterName == resource.data.reporterName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.meTooBy == resource.data.meTooBy
            && request.resource.data.get('screenshotUrl', null) == resource.data.get('screenshotUrl', null)
            && request.resource.data.commentCount == resource.data.commentCount
            && isConsistentStatusChange()
            && adminPanelChanges(['status', 'priority', 'duplicateOf', 'statusHistory'])));

      match /comments/{commentId} {
        allow read: if request.auth != null
          && (isAdmin()
              || request.auth.uid == get(/databases/$(database)/documents/bugReports/$(reportId)).data.reporterUid);

        allow create: if request.auth != null
          && (isAdmin()
              || request.auth.uid == get(/databases/$(database)/documents/bugReports/$(reportId)).data.reporterUid)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.authorId is string
          && request.resource.data.authorName is string
          && request.resource.data.isAdminAuthor is bool
          && (request.resource.data.isAdminAuthor == false || isAdmin());

        allow update, delete: if false;
      }
    }
  }
}
