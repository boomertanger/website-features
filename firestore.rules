rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Written only by the syncAdminStatus Cloud Function via the Admin SDK,
    // which bypasses these rules entirely. Never touched directly by clients.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Managed by hand in the Firebase console (or the Admin SDK).
    // Existence of a doc, keyed by lowercase email, marks that email as admin.
    match /adminAllowlist/{email} {
      allow read, write: if false;
    }

    // A member may toggle their own vote (add/remove exactly one entry in
    // votes) without touching anything else. Note: like requesterId, the
    // voter's id isn't identity-verified — someone could vote under a
    // fabricated id, or from two browsers. Acceptable given the stakes;
    // this is not a fraud-proof tally, just a lightweight signal.
    function isSingleVoteToggle() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeVotes = before.get('votes', []);
      let afterVotes = after.get('votes', []);
      let added = afterVotes.toSet().difference(beforeVotes.toSet());
      let removed = beforeVotes.toSet().difference(afterVotes.toSet());
      return request.auth != null
        && after.title == before.title
        && after.description == before.description
        && after.status == before.status
        && after.priority == before.priority
        && after.requesterId == before.requesterId
        && after.requesterName == before.requesterName
        && after.statusHistory == before.statusHistory
        && after.createdAt == before.createdAt
        && ((added.size() == 1 && removed.size() == 0)
            || (added.size() == 0 && removed.size() == 1));
    }

    match /featureRequests/{requestId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.status == "submitted"
        && request.resource.data.priority == null
        && request.resource.data.votes == []
        && request.resource.data.requesterId is string
        && request.resource.data.requesterName is string;

      // Only a real, verified admin (see isAdmin()) can change anything
      // after creation, and only status/priority/history fields.
      allow update: if (isAdmin()
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.requesterName == resource.data.requesterName)
        || isSingleVoteToggle();

      allow delete: if isAdmin();
    }
  }
}
