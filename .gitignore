.DS_Store
*.log
.env
# functions/.env holds public function params only (the Twitch client ID); secrets
# go in Secret Manager, never here.
!functions/.env
node_modules/

# New site (site/)
site/node_modules/
site/dist/
site/.astro/

# Staff-only material (the mod guide); the repo is public, so never committed
functions/scripts/private/

# Local audit notes, never committed
docs/ui-audit.md

# Tech Stack Fan Club text (docs/specs/tech-stack.md §6): the real file stays local while the repo is public; the .sample.json is committed
functions/scripts/data/tech-stack-member.json

# Base Camp (docs/specs/base-camp.md): the Fan Club text, the mailing address and Skipper's
# raw media stay local while the repo is public
functions/scripts/data/base-camp-member.json
functions/scripts/data/skipper-media/

# Creator Climb (docs/specs/creator-climb.md): the private follower history stays local while the repo is public
functions/scripts/data/climb-history.json
functions/scripts/data/climb-sheet.csv

# The Playbook (docs/specs/playbook.md): the private seed, the look reference, and every export or backup stay local while the repo is public
functions/scripts/data/playbook.json
functions/scripts/data/playbook-mockup.html
functions/scripts/data/playbook-*.json
