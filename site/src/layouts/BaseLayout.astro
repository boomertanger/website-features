---
// One layout for every page: header, main, footer (+ phone tab bar).
// <body> is the page's bt-root (.bt-site: see docs/design-system.md §8d).
// Kit imported at build time, then the site's page-level CSS.
import "../../../shared/bt-ui.css";
import "../styles/site.css";
import IconSprite from "../components/IconSprite.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TabBar from "../components/TabBar.astro";
import PreviewChip from "../components/PreviewChip.astro";
import AccountBanners from "../components/account/AccountBanners.astro";
import Mascot from "../components/Mascot.astro";
import TalkBackNote from "../components/services/TalkBackNote.astro";
import { manifestFor } from "../lib/service-manifests";
import site from "../data/site.json";
import { isProduction, firebaseEnv } from "../lib/env.js";

interface Props {
  title?: string;
  description?: string;
  /** Home: the header sits over the hero. */
  overlayHeader?: boolean;
  /** Keep this page out of search everywhere (auth callbacks, admin). */
  noindex?: boolean;
  /** A page that stands on its own in link previews and search: "Title | Boomertanger" (the Game Vault's /games). */
  fullTitle?: boolean;
}
const { title, description = site.tagline, overlayHeader = false, noindex = false, fullTitle = false } = Astro.props;
// The page strip (Service Hub §8a): the service whose manifest claims this route, if any (its talkBack value decides; TalkBackNote.astro).
const stripService = manifestFor(Astro.url.pathname);
const pageTitle = title ? `${title}${fullTitle ? " | " : " · "}${site.name}` : `${site.name}: ${site.tagline}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    {(noindex || !isProduction) && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.svg?v=mascot" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bt-root bt-site" data-live={site.liveState} data-auth="visitor" data-staff="off" data-crew="off" data-overseer="off" data-owner="off" data-auth-state="loading" data-env={firebaseEnv}>
    <script is:inline>
      // The last known sign-in (localStorage "bt.who", written by lib/auth.ts), on <body> before first paint: data-auth, data-staff and
      // the role flags data-crew / data-overseer / data-owner (.bt-when-* in bt-ui.css). Role-only links are in the HTML and show from the
      // first frame instead of popping in once Firebase restores the session; the real sign-in confirms or corrects them. Again when a
      // page comes back from the back-forward cache. Display only.
      (function () {
        var apply = function () {
          var b = document.body, w = null;
          try { w = JSON.parse(localStorage.getItem("bt.who") || "null"); } catch (e) { w = null; }
          if (b.dataset.previewAuth) return;
          var on = function (v) { return v ? "on" : "off"; };
          b.dataset.auth = w && w.v === 1 ? w.auth : "visitor";
          b.dataset.staff = on(w && w.v === 1 && w.staff);
          b.dataset.crew = on(w && w.v === 1 && w.crew);
          b.dataset.overseer = on(w && w.v === 1 && w.overseer);
          b.dataset.owner = on(w && w.v === 1 && w.owner);
        };
        apply();
        addEventListener("pageshow", function (e) { if (e.persisted) apply(); });
      })();
    </script>
    {!isProduction && (
      <script is:inline>
        // Preview switches (staging and previews only): ?as=visitor|member|admin
        // and ?live=off|public|backstage set data-auth / data-live on <body>
        // before anything renders, the same way the mockup does.
        (function () {
          var p = new URLSearchParams(location.search), b = document.body;
          var as = p.get("as"), live = p.get("live");
          // ?as= roles: [data-auth, staff, crew, overseer, owner]. admin and owner preview the owner; a2 an A2 Overseer; crew (and the
          // Mod Deck's captain / lead / deckhand, the questions page's mod) a crew member such as a Warden or an Initiate.
          var R = { visitor: ["visitor", 0, 0, 0, 0], member: ["member", 0, 0, 0, 0], admin: ["admin", 1, 1, 1, 1], owner: ["admin", 1, 1, 1, 1], a2: ["admin", 1, 1, 1, 0],
            crew: ["member", 1, 1, 0, 0], mod: ["member", 1, 1, 0, 0], captain: ["member", 1, 1, 0, 0], lead: ["member", 1, 1, 0, 0], deckhand: ["member", 1, 1, 0, 0] }[as];
          if (R) {
            var on = function (v) { return v ? "on" : "off"; };
            b.dataset.auth = b.dataset.previewAuth = R[0];
            b.dataset.staff = on(R[1]); b.dataset.crew = on(R[2]); b.dataset.overseer = on(R[3]); b.dataset.owner = on(R[4]);
            // a feature bar's links keep the preview role, so a preview can be walked through page to page (and back and forward)
            document.addEventListener("click", function (e) {
              var a = e.target && e.target.closest ? e.target.closest(".bt-sticky-bar a[href]") : null;
              if (!a) return;
              var u = new URL(a.getAttribute("href"), location.href);
              if (u.origin !== location.origin || u.searchParams.has("as")) return;
              u.searchParams.set("as", as);
              a.setAttribute("href", u.pathname + u.search + u.hash);
            }, true);
          }
          if (["off", "public", "backstage"].indexOf(live) >= 0) b.dataset.live = live;
          else if (p.get("playing") === "live") b.dataset.live = "public";   // the Game Vault spotlight's ?playing=live preview: Boomer is live
        })();
      </script>
    )}
    <IconSprite />
    <div class="bt-site-frame">
      <a class="bt-skip" href="#main">Skip to content</a>
      <SiteHeader overlay={overlayHeader} />
      <AccountBanners />
      <!-- The check-in banner (scripts/live/site-banner.ts) drops in here while a window is open. -->
      <div class="bt-live-banner-host" data-live-banner hidden></div>
      <!-- A section's sticky bar (the Arcade's): here in the frame, not inside <main>, so it
           stays stuck to the end of the page, footer included. -->
      <slot name="bar" />
      <main id="main" class="bt-site-main" tabindex="-1">
        <slot />
        {stripService && stripService.talkBack !== "skip" && <TalkBackNote service={stripService.id} />}
      </main>
      <SiteFooter />
    </div>
    <TabBar />
    <!-- The mascot for script-built UI (the sign-in dialog clones it). -->
    <template id="bt-mascot-tpl"><Mascot decorative /></template>
    {!isProduction && <PreviewChip />}
    <script>
      import "../scripts/stream-time.js";
      // Real auth state (lib/auth.ts): runs after the ?as= preview script above,
      // and a signed-in member always wins over it.
      import { startAuth } from "../lib/auth";
      startAuth();
      // The live state (data-live on <body>): ONE public/live listener per tab, opened once the page is idle (lib/live.ts).
      import { startLiveWhenIdle } from "../lib/live";
      startLiveWhenIdle();
      // "Offline" or the next stream's time on the beacon and the phone tab (the real schedule; never a placeholder).
      import { onLive, livePreview } from "../lib/live";
      import { rememberRoomFromLink } from "../scripts/live/checkin-flow";
      rememberRoomFromLink();   // a ?room= link on any page sets the room the check-in preselects
      // The check-in banner: its code loads only when public/live says a window is open (preview: ?state=break on any page).
      const startBanner = () => import("../scripts/live/site-banner").then((m) => m.startSiteBanner());
      if (livePreview()) { if (["break"].includes(livePreview()!.state || "")) void startBanner(); }
      else setTimeout(() => onLive((p) => { if (p.state !== "off" && p.window.open) void startBanner(); }), 1500);
      // The live drop banner (live drops): its code loads only when public/live has a drop, from the same listener (preview: ?drop= on any page).
      import { isProduction as prodSite } from "../lib/env.js";
      const startDrop = () => import("../scripts/live/drop-banner").then((m) => m.startDropBanner());
      if (!prodSite && new URLSearchParams(location.search).has("drop")) void startDrop();
      else setTimeout(() => onLive((p) => { if (p.drop) void startDrop(); }), 1500);
      import { paintNextLabels } from "../lib/offline-next";
      if (!new URLSearchParams(location.search).has("live")) setTimeout(() => void paintNextLabels(), 1500);
      import "../scripts/account/ui";
      import "../scripts/factory/site-wide";
      // Header menus (Watch / Play / Community): hover or click opens a panel.
      import { initNavGroups } from "../../../shared/ui/navgroup.js";
      import { onNavOpen, onNavClose } from "../scripts/nav-features";
      initNavGroups(document, { onOpen: onNavOpen, onClose: onNavClose });
    </script>
  </body>
</html>
