---
// One layout for every Game Vault page (docs/specs/game-vault.md §9): the site shell, the
// sticky GAMEVAULT bar in BaseLayout's "bar" slot (so it stays stuck to the end of the page),
// then the page. Vault pages are public; member actions check in the scripts.
import BaseLayout from "./BaseLayout.astro";
import VaultBar from "../components/vault/VaultBar.astro";
import "../styles/how-it-works.css";   // the How it works blocks (shared with the Arcade); before game-vault.css so the Vault's scenes win ties
import "../styles/game-vault.css";

interface Props { title: string; description?: string; section?: string | null }
const { title, description, section = null } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <VaultBar slot="bar" section={section} />
  <div class="gv-wrap"><slot /></div>
</BaseLayout>

<script>
  import "../scripts/vault/layout";
</script>
