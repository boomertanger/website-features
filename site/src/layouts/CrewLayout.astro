---
// One layout for every Mod Machina page (docs/specs/mod-machina.md §12): the site shell, the sticky MOD MACHINA
// bar in BaseLayout's "bar" slot, then the page. Like Night Shift's:
//   membersOnly  signed-up members see the page; visitors get the Join gate, mid-signup Finish signup
//   crewOnly     mods and admins see the page; everyone else a short "Crew only" gate
//   adminOnly    admins only (the /admin/crew pages, admin green); everyone else an "Admins only" gate
// Display-only: pages are static and read their data in scripts through callables or public docs; the
// server checks roles. scripts/crew/layout.ts sets .cr[data-access] = loading | gate | join | signup | page.
import BaseLayout from "./BaseLayout.astro";
import CrewBar from "../components/crew/CrewBar.astro";
import { MM_ICON } from "../../../shared/ui/mod-machina.js";
import "../styles/crew.css";

interface Props { title: string; description?: string; membersOnly?: boolean; crewOnly?: boolean; adminOnly?: boolean; section?: string | null; wide?: boolean }
const { title, description, membersOnly = false, crewOnly = false, adminOnly = false, section = null, wide = false } = Astro.props;
const gated = membersOnly || crewOnly || adminOnly;
const staff = crewOnly || adminOnly;
---
<BaseLayout title={title} description={description} noindex={adminOnly}>
  <CrewBar slot="bar" section={section} admin={adminOnly} gated={gated} />
  <div class:list={["cr", wide && "cr--wide"]} data-cr data-access={gated ? "loading" : "page"} data-crew-only={crewOnly ? "" : undefined} data-admin-only={adminOnly ? "" : undefined} data-members-only={membersOnly ? "" : undefined}>
    {gated && (
      <>
        <div class="bt-zone cr-skel" aria-hidden="true">
          <span class="bt-skeleton cr-skel-title"></span>
          <span class="bt-skeleton cr-skel-line"></span>
          <span class="bt-skeleton cr-skel-card"></span>
        </div>
        <section class="bt-zone cr-gate" aria-labelledby="cr-gate-title">
          <span class="cr-gate-art" aria-hidden="true" set:html={MM_ICON} />
          <h1 class="bt-title" id="cr-gate-title">{adminOnly ? "Admins only" : crewOnly ? "Crew only" : "Members only"}</h1>
          <p class="cr-gate-lead" hidden={!staff}>{adminOnly ? "These pages are for site admins. If you're one, sign in with your admin account." : "This page is for the crew. If you're a mod or admin, sign in with your crew account. Want to help? Apply to join."}</p>
          <p class="cr-gate-lead" hidden={staff}>This page is for members. Joining is free.</p>
          <div class="cr-gate-acts" data-cr-gate-visitor>
            {staff
              ? <a class="bt-btn bt-btn--primary" href="/account" data-signin="signin">Sign in</a>
              : <a class="bt-btn bt-btn--primary" href="/account" data-signin="join" data-signin-title="Join to help the crew">Join free</a>}
            {!staff && <a class="bt-btn bt-btn--secondary" href="/account" data-signin="signin">Log in</a>}
          </div>
          <div class="cr-gate-acts" data-cr-gate-signup hidden>
            <button type="button" class="bt-btn bt-btn--primary" data-signin="signup">Finish signup</button>
          </div>
          <a class="bt-btn bt-btn--ghost" href={staff ? "/crew/join" : "/crew"}>{staff ? "Apply to join the crew" : "Meet the crew"}</a>
        </section>
      </>
    )}
    <div class="cr-page"><slot /></div>
  </div>
</BaseLayout>

<script>
  import "../scripts/crew/layout";
</script>
