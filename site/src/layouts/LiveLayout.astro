---
// The Control Room's staff pages (docs/specs/control-room.md §2): a thin wrapper around the live tools' shared frame (LiveFrame.astro: the
// site shell, the CONTROLROOM bar, the .lv wrapper; the same frame as the Mod Deck) with the Control Room's gate. Gated:
//   staffOnly   the owner and A2 Overseer and up see the page; visitors get the Sign in gate, mid-signup Finish signup, everyone else
//               (including an A1 Steward) the no-access state
//   ownerOnly   the owner's uid only (the checklist templates); an A2 gets the no-access state
// Display-only: pages are static and read their data in scripts; the server and the rules check again.
// scripts/live/layout.ts sets .lv[data-access] = loading | gate | join | signup | page.
import LiveFrame from "./LiveFrame.astro";
import { CR_ICON } from "../../../shared/ui/control-room.js";

interface Props { title: string; description?: string; ownerOnly?: boolean; section?: string | null }
const { title, description, ownerOnly = false, section = null } = Astro.props;
---
<LiveFrame title={title} description={description} brand="control" section={section} ownerOnly={ownerOnly}>
  <section slot="gate" class="bt-zone lv-gate" aria-labelledby="lv-gate-title">
    <span class="lv-gate-art" aria-hidden="true" set:html={CR_ICON} />
    <h1 class="bt-title" id="lv-gate-title">{ownerOnly ? "Owner only" : "Control Room"}</h1>
    <p class="lv-gate-lead" data-lv-gate-lead>{ownerOnly ? "The checklist templates are private to the owner." : "The Control Room is for the owner and the Overseers. If you're one, sign in with your admin account."}</p>
    <div class="lv-gate-acts" data-lv-gate-visitor hidden>
      <a class="bt-btn bt-btn--primary" href="/account" data-signin="signin">Sign in</a>
    </div>
    <div class="lv-gate-acts" data-lv-gate-signup hidden>
      <button type="button" class="bt-btn bt-btn--primary" data-signin="signup">Finish signup</button>
    </div>
    <a class="bt-btn bt-btn--ghost" href="/live">Go to the live page</a>
  </section>
  <slot />
</LiveFrame>

<script>
  import "../scripts/live/layout";
</script>
