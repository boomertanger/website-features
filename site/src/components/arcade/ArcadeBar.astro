---
// The Arcade's feature top bar (docs/specs/arcade-step1.md §7, design-system.md §8h):
// the kit's .bt-topbar + .bt-wordmark (joystick, BOOM + accent ARCADE) linking to
// /arcade, and Games / Leaderboards / How it works on the right (hidden on phones and
// on the members-only gate). No breadcrumbs.
import { BA_ICON } from "../../../../shared/ui/arcade.js";

interface Props { section?: "games" | "lb" | "how" | null }
const { section = null } = Astro.props;
const links = [
  { id: "games", label: "Games", href: "/arcade" },
  { id: "lb", label: "Leaderboards", href: "/arcade/leaderboards" },
  { id: "how", label: "How it works", href: "/arcade/how-it-works" },
];
---
<div class="bt-topbar ar-bar">
  <a class="bt-wordmark" href="/arcade" aria-label="Boom Arcade">
    <span class="bt-wordmark-icon" set:html={BA_ICON} />
    <span class="bt-wordmark-text" aria-hidden="true">BOOM<span class="bt-wordmark-accent">ARCADE</span></span>
  </a>
  <nav class="bt-topnav ar-barlinks" aria-label="Arcade">
    {links.map((l) => (
      <a class="bt-btn bt-btn--ghost bt-btn--sm" href={l.href} aria-current={section === l.id ? "page" : undefined}>{l.label}</a>
    ))}
  </nav>
</div>
