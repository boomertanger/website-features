---
// The live tools' feature bar, shared by the Control Room (/live/control and its staff pages) and the Mod Deck (/live/deck), so the two line
// up exactly when you go from one to the other (the Mod Machina / Scream Planner pattern): the kit's .bt-topbar in a .bt-sticky-bar with the
// radar-scope .bt-wordmark--power (crWordmarkHtml: CONTROL ROOM or MOD DECK) and ONE seg nav on both pages: Live page, Controls (admins),
// Mod Deck, Crew HQ, How duty works and, for the owner's uid only, Checklist templates (added by scripts/live/bar.ts: there is never an
// empty slot for anyone else). The current page is aria-current. Icon-only on phones. Rendered by LiveFrame.astro.
import { crWordmarkHtml } from "../../../../shared/ui/control-room.js";

interface Props { brand?: "control" | "deck"; section?: string | null; gated?: boolean }
const { brand = "control", section = null, gated = false } = Astro.props;
const wordmark = brand === "deck"
  ? crWordmarkHtml({ href: "/live/deck", label: "Mod Deck", words: ["MOD", "DECK"] })
  : crWordmarkHtml({ href: "/live/control" });
const links = [
  { id: "live", label: "Live page", href: "/live", icon: "live", admin: false },
  { id: "control", label: "Controls", href: "/live/control", icon: "wrench", admin: true },
  { id: "deck", label: "Mod Deck", href: "/live/deck", icon: "club", admin: false },
  { id: "hq", label: "Crew HQ", href: "/crew/hq", icon: "home", admin: false },
  { id: "how", label: "How duty works", href: "/crew/how-it-works", icon: "help", admin: false },
];
const label = brand === "deck" ? "Mod Deck" : "Control Room";
---
<div class="bt-sticky-bar lv-dock" data-lv-dock data-gated={gated ? "" : undefined}>
  <div class="bt-topbar lv-bar">
    <div class="lv-brand" set:html={wordmark} />
    <nav class="bt-seg-nav lv-barlinks" aria-label={label}>
      {links.map((l) => <a class:list={[l.admin && "bt-when-admin"]} href={l.href} aria-current={section === l.id ? "page" : undefined}>{l.label}</a>)}
      <span class="lv-owner-slot" data-lv-owner-slot hidden></span>
    </nav>
    <nav class="bt-seg-nav bt-seg-nav--icons lv-barico" aria-label={label}>
      {links.map((l) => <a class:list={[l.admin && "bt-when-admin"]} href={l.href} aria-label={l.label} title={l.label} aria-current={section === l.id ? "page" : undefined}><svg aria-hidden="true"><use href={`#i-${l.icon}`} /></svg></a>)}
      <span class="lv-owner-slot" data-lv-owner-slot data-icon="1" hidden></span>
    </nav>
  </div>
</div>
