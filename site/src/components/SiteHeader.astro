---
// Site header: logo, main navigation, Live Beacon, account area.
// The account buttons aren't wired up yet (accounts come in a later
// milestone); signed-in states are previewed with ?as=member / ?as=admin.
import Logo from "./Logo.astro";
import LiveBeacon from "./LiveBeacon.astro";
import member from "../data/preview-member.json";
import { navItems, isCurrent } from "../lib/nav.js";

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={["bt-site-header", overlay && "bt-site-header--overlay"]}>
  <Logo />
  <nav class="bt-nav" aria-label="Main">
    {navItems.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href, path) ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>
  <span class="bt-spacer"></span>
  <span class="bt-beacon-slot"><LiveBeacon /></span>
  <div class="bt-account bt-account--wide">
    <span class="bt-account bt-when-visitor">
      <a class="bt-btn bt-btn--ghost bt-btn--sm" href="/account">Log in</a>
      <a class="bt-btn bt-btn--primary bt-btn--sm" href="/account">Join free</a>
    </span>
    <a class="bt-admin-link bt-when-admin" href="/account">Admin</a>
    <a class="bt-account-btn bt-when-signed-in" href="/account"><span class="bt-avatar-sm" aria-hidden="true">{member.initials}</span>{member.name}</a>
  </div>
  <div class="bt-account bt-account--compact">
    <a class="bt-btn bt-btn--primary bt-btn--sm bt-when-visitor" href="/account">Join</a>
    <a class="bt-account-btn bt-when-signed-in" href="/account" style="padding:3px" aria-label="Account"><span class="bt-avatar-sm" aria-hidden="true">{member.initials}</span></a>
  </div>
</header>
