---
// The Service Hub's feature bar (docs/specs/service-hub.md §8; mockup service-hub-round-1.html, the SERVICEHUB wordmark): the kit's .bt-topbar in a
// .bt-sticky-bar, the SERVICE HUB .bt-wordmark--power with the hub icon (on hover or focus the spokes light and the nodes pulse once; touch screens
// play it as it scrolls into view), and a ghost How it works link (current on that page). Under 640px the link becomes an icon with its aria-label.
interface Props { section?: "how" | null }
const { section = null } = Astro.props;
const HUB = `<svg class="sv-wm-ic" viewBox="0 0 34 34" aria-hidden="true"><path class="spoke" d="M17 17 6 7M17 17l11-9M17 17v12"/><circle class="hub" cx="17" cy="17" r="6.5"/><circle class="n n1" cx="6" cy="7" r="3.2"/><circle class="n n2" cx="28" cy="8" r="3.2"/><circle class="n n3" cx="17" cy="29.5" r="3.2"/></svg>`;
const HELP = `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7M12 17h.01"/></svg>`;
---
<div class="bt-sticky-bar sv-dock" data-sv-dock>
  <div class="bt-topbar sv-bar">
    <a class="bt-wordmark bt-wordmark--power sv-wm" href="/services" aria-label="Service Hub">
      <span class="bt-wordmark-icon" set:html={HUB} />
      <span class="bt-wordmark-text" aria-hidden="true">SERVICE<span class="bt-wordmark-accent">HUB</span></span>
    </a>
    <div class="bt-topnav">
      <a class="bt-btn bt-btn--ghost bt-btn--sm sv-how" href="/services/how-it-works" aria-label="How it works" aria-current={section === "how" ? "page" : undefined}><Fragment set:html={HELP} /><span class="bt-btn-label">How it works</span></a>
    </div>
  </div>
</div>
