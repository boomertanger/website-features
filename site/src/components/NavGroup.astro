---
// One header menu: a trigger plus its panel of page cards and a feature tile
// (docs/specs/header-nav.md, design-system.md §5 "Header nav groups"). Without
// JavaScript the trigger is a link to the group's first page and the panel stays
// hidden; shared/ui/navgroup.js upgrades it to a disclosure button.
// All three feature tiles show a shimmer until scripts/nav-features.ts fills them the first time their panel opens
// (Watch: the live stream or the next one from the real schedule, or "Offline"; never a placeholder).
import { featureLoadingHtml } from "../../../shared/ui/navgroup.js";
import { isCurrent, isInSection, groupIsCurrent } from "../lib/nav.js";

interface Item { id: string; label: string; href: string; icon: string; blurb: string; staff?: boolean }
interface Props { group: { id: string; label: string; items: Item[] }; path: string }
const { group, path } = Astro.props;
const current = groupIsCurrent(group, path);
const panelId = `bt-ng-${group.id}`;
---
<span class="bt-navgroup" data-navgroup={group.id}>
  <a class:list={["bt-navgroup-btn", current && "is-current"]} href={group.items[0].href} data-navgroup-trigger aria-controls={panelId}>
    {group.label}
    {group.id === "watch" && <><span class="bt-navgroup-dot bt-when-public" aria-hidden="true"></span><span class="bt-sr-only bt-when-public">, live now</span></>}
    <svg class="bt-navgroup-chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
  <div class="bt-navgroup-panel" id={panelId} hidden>
    <div class="bt-navgroup-links">
      {group.items.map((i) => (
        <a class:list={["bt-navgroup-link", i.id === "live" && "bt-navgroup-link--live", i.staff && "bt-when-staff"]} href={i.href} aria-current={isCurrent(i.href, path) || isInSection(i.href, path) ? "page" : undefined}>
          <span class="bt-navgroup-ic" aria-hidden="true"><svg><use href={`#i-${i.icon}`} /></svg></span>
          <span class="bt-navgroup-name">{i.label}{i.id === "live" && <span class="bt-badge bt-badge--red bt-when-public" aria-hidden="true">Live</span>}</span>
          <span class="bt-navgroup-blurb">{i.blurb}</span>
        </a>
      ))}
    </div>
    {group.id === "watch" && (
      <div class="bt-navgroup-feature is-watch" data-navgroup-feature="watch" aria-live="polite" set:html={featureLoadingHtml("Next stream")} />
    )}
    {group.id === "play" && (
      <div class="bt-navgroup-feature" data-navgroup-feature="play" aria-live="polite" set:html={featureLoadingHtml("Today in the Arcade")} />
    )}
    {group.id === "community" && (
      <div class="bt-navgroup-feature" data-navgroup-feature="community" aria-live="polite" set:html={featureLoadingHtml("The crew")} />
    )}
  </div>
</span>
