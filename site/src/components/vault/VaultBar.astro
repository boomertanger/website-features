---
// The Game Vault's feature bar (docs/specs/game-vault.md §9): the kit's .bt-topbar in a
// .bt-sticky-bar like the Arcade's, with the GAMEVAULT .bt-wordmark--power (the vault-dial icon
// rests; on hover or focus it spins a combination and lights the lamp; touch screens play it
// once as it scrolls into view). Right: Queue with its count (staff, admin green) and Add a game
// (everyone; visitors get the Join dialog titled "Join to add games"). Wired in
// scripts/vault/layout.ts.
import { GV_ICON } from "../../scripts/vault/art";
import { I } from "../../scripts/vault/art";
---
<div class="bt-sticky-bar gv-dock" data-gv-dock>
  <div class="bt-topbar gv-bar">
    <a class="bt-wordmark bt-wordmark--power" href="/games" aria-label="Game Vault">
      <span class="bt-wordmark-icon" set:html={GV_ICON} />
      <span class="bt-wordmark-text" aria-hidden="true">GAME<span class="bt-wordmark-accent">VAULT</span></span>
    </a>
    <div class="bt-topnav">
      <a class="bt-btn bt-btn--admin bt-btn--sm" href="/games/queue" data-gv-queue hidden><Fragment set:html={I.queue} /><span class="bt-btn-label">Queue</span> <span class="bt-chip-n" data-gv-queue-n></span></a>
      <button type="button" class="bt-btn bt-btn--primary bt-btn--sm" data-gv-add aria-label="Add a game"><Fragment set:html={I.plusSm} /><span class="bt-btn-label">Add a game</span></button>
    </div>
  </div>
</div>
