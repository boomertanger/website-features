---
// The BASECAMP bar (docs/specs/base-camp.md "Brand"; design-system.md §8h pattern, like the Trophy Room's): the kit's .bt-topbar in a
// .bt-sticky-bar with the BASECAMP .bt-wordmark--power (W1 peak and tent: CAMP rests purple and lights gold, the tent door lights on hover or
// focus) and The story / Newfoundland / Skipper / Mail Call as a .bt-seg-nav (hidden on phones). Wired in scripts/base-camp/layout.ts.
import { BC_ICON } from "../../scripts/base-camp/ui";

interface Props { section?: "story" | "newfoundland" | "skipper" | "mailcall" | null }
const { section = null } = Astro.props;
const links = [
  { id: "story", label: "The story", href: "/base-camp" },
  { id: "newfoundland", label: "Newfoundland", href: "/base-camp/newfoundland" },
  { id: "skipper", label: "Skipper", href: "/base-camp/skipper" },
  { id: "mailcall", label: "Mail Call", href: "/base-camp/mail-call" },
];
---
<div class="bt-sticky-bar bc-dock" data-bc-dock>
  <div class="bt-topbar bc-bar">
    <a class="bt-wordmark bt-wordmark--power" href="/base-camp" aria-label="Base Camp">
      <span class="bt-wordmark-icon" set:html={BC_ICON} />
      <span class="bt-wordmark-text" aria-hidden="true">BASE<span class="bt-wordmark-accent">CAMP</span></span>
    </a>
    <nav class="bt-seg-nav" aria-label="Base Camp">
      {links.map((l) => <a href={l.href} aria-current={section === l.id ? "page" : undefined}>{l.label}</a>)}
    </nav>
  </div>
</div>
