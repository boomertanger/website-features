---
// Animated Boom Board icon (speech bubble, bursting star, rising dots), exactly as in the mockup.
interface Props { size?: number }
const { size } = Astro.props;
const style = size ? `width:${size}px;height:${size}px` : undefined;
---
<svg class="bt-bb-icon" viewBox="0 0 32 32" aria-hidden="true" style={style}>
  <circle class="dot d1" cx="23" cy="7" r="1.7"/>
  <circle class="dot d2" cx="27" cy="4" r="1.3"/>
  <circle class="dot d3" cx="19.5" cy="3.5" r="1.1"/>
  <path class="bubble" d="M6 8.5h16a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-8l-5.5 4.5v-4.5H6a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3z"/>
  <circle class="ring" cx="14" cy="15.5" r="6"/>
  <path class="burst" d="M14.00,9.90 L14.96,13.19 L17.96,11.54 L16.31,14.54 L19.60,15.50 L16.31,16.46 L17.96,19.46 L14.96,17.81 L14.00,21.10 L13.04,17.81 L10.04,19.46 L11.69,16.46 L8.40,15.50 L11.69,14.54 L10.04,11.54 L13.04,13.19Z"/>
</svg>
