---
// Account page, A2 tabs (docs/design/mockups/accounts.html; docs/specs/accounts.md
// screen 10): Profile, Linked accounts, Sign-in methods, Privacy, Your data. Phones:
// the tabs are a swipeable pill row. Real account data only (the ?as= preview
// doesn't apply here); scripts/account/page.ts fills and drives it.
import BaseLayout from "../layouts/BaseLayout.astro";
import AccountPanes from "../components/account/AccountPanes.astro";

---
<BaseLayout title="Account">
  <div class="bt-zone">
    <div class="bt-page-intro"><h1 class="bt-title">Your account</h1></div>

    <div class="bt-when-auth-loading" aria-hidden="true">
      <div class="bt-skeleton-row"><span class="bt-skeleton" style="width:72px;height:72px;border-radius:50%"></span><span class="bt-skeleton-lines"><span class="bt-skeleton" style="height:14px;width:40%"></span><span class="bt-skeleton" style="height:12px;width:60%"></span></span></div>
    </div>

    <div class="bt-card" data-acct-when="signedOut" hidden>
      <div class="bt-card-head"><h2 class="bt-card-title">Sign in to see your account</h2></div>
      <p class="bt-section-text">Your profile, linked accounts and privacy settings live here.</p>
      <div><button type="button" class="bt-btn bt-btn--primary" data-signin="signin">Sign in</button> <button type="button" class="bt-btn bt-btn--secondary" data-signin="join">Join free</button></div>
    </div>

    <div class="bt-card" data-acct-when="needsSignup" hidden>
      <div class="bt-card-head"><h2 class="bt-card-title">Almost there</h2></div>
      <p class="bt-section-text">Finish creating your account: your birthday, a handle, and the terms.</p>
      <div><button type="button" class="bt-btn bt-btn--primary" data-signin="signup">Finish signup</button></div>
    </div>

    <AccountPanes />
  </div>
</BaseLayout>

<script>
  import "../scripts/account/page";
</script>
