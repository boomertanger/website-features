---
// Terms of Service, rendered from site/src/content/legal/terms.md exactly as written
// (the "[effective date]" placeholder stays until launch). Non-production builds are
// noindex through BaseLayout; production is indexable. The "On this page" menu is built
// at build time from the Markdown's own h2 headings (the ids Astro gives them), in the
// shared TocLayout; .bt-prose--chapters numbers those headings "01 · Section".
import BaseLayout from "../layouts/BaseLayout.astro";
import TocLayout from "../components/TocLayout.astro";
import { Content, getHeadings } from "../content/legal/terms.md";

const items = getHeadings().filter((h) => h.depth === 2).map((h) => [h.slug, h.text] as [string, string]);
---
<BaseLayout title="Terms of Service" description="The rules for using Boomertanger: accounts, community rules, games and leaderboards, and your content.">
  <TocLayout items={items}>
    <article class="bt-prose bt-prose--chapters"><Content /></article>
  </TocLayout>
</BaseLayout>
