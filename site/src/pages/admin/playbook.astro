---
// /admin/playbook, The Playbook (docs/specs/playbook.md): the owner's private living plan. Owner only (scripts/playbook/page.ts checks sites/{id}.ownerUid;
// firestore.rules deny every read to anyone else, admins included). All Playbook text lives in Firestore and is drawn in the browser; this file holds
// only the frame and its states: loading, sign in, not yours, not seeded, couldn't load, the page. Not in the header nav; the owner's /admin card links here.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BOOK_ICON } from "../../scripts/playbook/art";
import "../../styles/how-it-works.css";
import "../../styles/toc-layout.css";
import "../../styles/playbook.css";
---
<BaseLayout title="The Playbook" noindex>
  <div slot="bar" class="bt-sticky-bar pb-bar-top" data-pb-dock>
    <div class="bt-topbar">
      <a class="bt-wordmark" href="/admin/playbook" aria-label="The Playbook">
        <span class="bt-wordmark-icon" set:html={BOOK_ICON} />
        <span class="bt-wordmark-text" aria-hidden="true">PLAY<span class="bt-wordmark-accent">BOOK</span></span>
      </a>
      <div class="pb-topnote"><span class="bt-admin-tag bt-admin-tag--small"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5z"/></svg>Owner only</span><span class="pb-topnote-t">Sharing unlocks after your first read-through</span></div>
    </div>
  </div>
  <div class="pb-wrap" data-pb-access="loading">
    <div class="pb-state pb-skel" data-state="loading" aria-hidden="true"><span class="bt-skeleton" style="height:40px"></span><span class="bt-skeleton" style="height:300px"></span><span class="bt-skeleton" style="height:90px"></span><span class="bt-skeleton" style="height:420px"></span></div>
    <section class="pb-state pb-gate" data-state="join"><h1 class="bt-title">Owner only</h1><p>The Playbook is Boomertanger's private plan. Sign in with the owner account.</p><a class="bt-btn bt-btn--primary" href="/account" data-signin="signin">Sign in</a></section>
    <section class="pb-state pb-gate" data-state="denied"><h1 class="bt-title">Owner only</h1><p>The Playbook is Boomertanger's private plan, and only the owner can open it.</p><a class="bt-btn bt-btn--secondary" href="/admin">Back to admin</a></section>
    <section class="pb-state" data-state="empty"><div class="bt-empty"><span class="bt-empty-title">The Playbook is empty. Run the seed.</span><span><code>node functions/scripts/seed-playbook.js</code> (a dry run), then again with <code>--apply</code>.</span></div></section>
    <section class="pb-state" data-state="error"><div class="bt-empty"><span class="bt-empty-title">Couldn't load the Playbook</span><span data-pb-error></span><button type="button" class="bt-btn bt-btn--secondary" data-pb-retry>Try again</button></div></section>
    <div class="pb-state pb" data-state="page" data-pb aria-live="polite"></div>
  </div>
</BaseLayout>

<script>
  import "../../scripts/playbook/page";
</script>
