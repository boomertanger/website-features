---
// Privacy Policy, rendered from site/src/content/legal/privacy.md exactly as written
// (the "[effective date]" placeholder stays until launch). Non-production builds are
// noindex through BaseLayout; production is indexable.
import BaseLayout from "../layouts/BaseLayout.astro";
import { Content } from "../content/legal/privacy.md";
---
<BaseLayout title="Privacy Policy" description="What Boomertanger collects, how it's used, and the choices you have.">
  <div class="bt-zone">
    <article class="bt-prose bt-prose--chapters"><Content /></article>
  </div>
</BaseLayout>
