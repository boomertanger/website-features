---
// /shift/leaderboard: the season leaderboard (docs/specs/fun-factory.md §8). Members only (FactoryLayout's
// gate). Board pills All / Sub Club / Crew, the top 25 with Show more up to 100, your row highlighted or
// pinned with your rank, and the final top 3 with their trophies once a season has ended. Filled by
// scripts/factory/leaderboard.ts.
import FactoryLayout from "../../layouts/FactoryLayout.astro";
---
<FactoryLayout title="Night Shift leaderboard" description="Who's leading this Night Shift season, by season XP." membersOnly section="leaderboard">
  <div class="bt-zone ff-wrap ff-lb-page" data-ff-lb aria-busy="true">
    <div class="ff-pass-skel" aria-hidden="true">
      <span class="bt-skeleton ff-skel-line"></span>
      <span class="bt-skeleton ff-skel-card"></span>
    </div>
  </div>
</FactoryLayout>

<script>
  import "../../scripts/factory/leaderboard";
</script>
