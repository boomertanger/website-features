---
// Admin tools (the green header link and the avatar menu's Admin tools). The admin
// member view with role controls is milestone 2b (docs/specs/accounts.md "Later").
// The owner also gets the growth collector's tools (docs/specs/growth-collector.md):
// Connect TikTok and Run the collector now. Admins get the Trophy Room's Award a badge card
// (docs/specs/rewards.md §10; scripts/admin/award.ts).
import BaseLayout from "../layouts/BaseLayout.astro";
import ComingSoon from "../components/ComingSoon.astro";
import TrophyOrder from "../components/trophies/TrophyOrder.astro";
---
<BaseLayout title="Admin tools" noindex>
  <ComingSoon title="Admin tools" lead="Member management and role controls.">
    The admin member view (member list, member detail with role controls) arrives in milestone 2b. Roles can be set with the setMemberRole function until then.
  </ComingSoon>
  <div class="bt-zone" data-ff-link hidden>
    <a class="bt-card bt-card--door" href="/factory/builder">
      <div class="bt-card-head"><h2 class="bt-card-title">Fun Factory builder</h2><span class="bt-badge bt-badge--teal">Mods and admins</span></div>
      <p class="bt-section-text">Plan seasons, review and schedule them, and manage the idea library.</p>
    </a>
  </div>
  <!-- Temporary: the TikTok count by hand until the TikTok API is approved (after launch). -->
  <div class="bt-zone" data-tiktok-manual hidden>
    <div class="bt-card">
      <div class="bt-card-head"><h2 class="bt-card-title">TikTok followers (manual)</h2><span class="bt-badge bt-badge--gray">Admins</span></div>
      <p class="bt-section-text" data-tm-connected hidden>Connected, updated automatically.</p>
      <form class="bt-stack" data-tm-form novalidate>
        <div class="bt-field">
          <label class="bt-label" for="bt-tm-n">Followers today, <span data-tm-today></span></label>
          <input class="bt-input" id="bt-tm-n" name="followers" type="number" inputmode="numeric" min="0" max="100000000" step="1" required />
        </div>
        <div class="bt-row-center"><button type="submit" class="bt-btn bt-btn--primary">Save</button></div>
        <p class="bt-fine" data-tm-last role="status"></p>
      </form>
    </div>
  </div>
  <div class="bt-zone" data-award hidden>
    <div class="bt-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Award a badge</h2><span class="bt-badge bt-badge--gray">Admins</span></div>
      <p class="bt-section-text">Give a member a crew-awarded badge, or take one back. Every award and revoke needs a reason, is logged, and adds or removes the badge's XP. You can't award yourself, and you can award 20 a day.</p>
      <form class="bt-stack" data-award-form novalidate>
        <div class="bt-field">
          <label class="bt-label" for="aw-handle">Member's handle</label>
          <input class="bt-input" id="aw-handle" name="handle" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="21" placeholder="@handle" required aria-describedby="aw-who" />
          <p class="bt-fine bt-fine--left" id="aw-who" data-aw-who aria-live="polite"></p>
        </div>
        <div class="bt-field">
          <label class="bt-label" for="aw-badge">Badge</label>
          <select class="bt-select" id="aw-badge" name="badge" required aria-describedby="aw-badge-note" disabled><option value="">Loading badges…</option></select>
          <p class="bt-fine bt-fine--left" id="aw-badge-note" data-aw-note aria-live="polite">Each badge says who can award it. Badges members earn on their own can't be awarded.</p>
        </div>
        <div class="bt-field">
          <label class="bt-label" for="aw-reason">Reason</label>
          <textarea class="bt-textarea" id="aw-reason" name="reason" maxlength="300" required aria-describedby="aw-count" placeholder="What did they do? The member sees this in their history."></textarea>
          <p class="bt-fine bt-fine--left" id="aw-count" data-aw-count>10 to 300 characters.</p>
        </div>
        <div class="bt-row-center">
          <button type="submit" class="bt-btn bt-btn--primary" data-aw-award>Award badge</button>
          <button type="button" class="bt-btn bt-btn--danger" data-aw-revoke>Revoke badge</button>
        </div>
      </form>
    </div>
  </div>
  <TrophyOrder />
  <div class="bt-zone" data-owner-tools hidden>
    <div class="bt-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Growth collector</h2><span class="bt-badge bt-badge--gray">Owner only</span></div>
      <p class="bt-section-text">Follower and subscriber counts for the footer's Follow badges, collected every day at 5 am Pacific.</p>
      <div class="bt-row-center">
        <button type="button" class="bt-btn bt-btn--secondary" data-run-growth>Run the collector now</button>
        <button type="button" class="bt-btn bt-btn--primary" data-connect-tiktok>Connect TikTok</button>
      </div>
      <p class="bt-fine" data-tiktok-status role="status"></p>
      <p class="bt-fine" data-growth-result role="status"></p>
    </div>
  </div>
</BaseLayout>

<script>
  // Owner and admin checks are for display only: the callables check on the server.
  import "../scripts/admin/award";
  import { whenReady } from "../lib/auth";
  import { messageFor } from "../lib/errors";
  import { startTikTok, tiktokReady } from "../lib/tiktok";

  // ---- TikTok followers (manual), until the API is approved (docs/specs/growth-collector.md §5b) ----
  const DAY_MS = 86400000;
  const laDate = (d = new Date()) => new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", weekday: "short", month: "short", day: "numeric", year: "numeric" }).format(d);
  async function manualTikTok(db: any, doc: any, getDoc: any, SITE_ID: string) {
    const card = document.querySelector<HTMLElement>("[data-tiktok-manual]")!;
    const form = card.querySelector<HTMLFormElement>("[data-tm-form]")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const last = form.querySelector<HTMLElement>("[data-tm-last]")!;
    card.querySelector<HTMLElement>("[data-tm-today]")!.textContent = laDate();
    card.hidden = false;
    const showLast = (followers: number | null, at: Date | null) => {
      if (followers == null || !at) { last.textContent = "No count saved yet. The footer shows Follow until there is one."; return; }
      const days = Math.floor((Date.now() - at.getTime()) / DAY_MS);
      const when = days <= 0 ? "today" : days === 1 ? "1 day ago" : `${days} days ago`;
      last.textContent = `Last saved ${when}: ${followers.toLocaleString("en-US")} followers.`
        + (days >= 7 ? " The footer now shows Follow instead of the count (older than 7 days). Save today's count to bring it back."
          : days > 5 ? " Reminder: update it soon; the footer hides counts older than 7 days." : "");
    };
    const socials = await getDoc(doc(db, "sites", SITE_ID, "public", "socials"));
    const tt = socials.exists() ? socials.get("tiktok") : null;
    if (tt?.source === "api") {
      form.hidden = true;
      card.querySelector<HTMLElement>("[data-tm-connected]")!.hidden = false;
      return;
    }
    if (typeof tt?.followers === "number") input.value = String(tt.followers);
    showLast(tt?.followers ?? null, tt?.updatedAt?.toDate?.() ?? null);
    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const n = Number(input.value);
      if (input.value === "" || !Number.isInteger(n) || n < 0 || n > 100000000) { last.textContent = "Enter a whole number from 0 to 100,000,000."; input.focus(); return; }
      const btn = form.querySelector<HTMLButtonElement>("button")!;
      btn.disabled = true;
      try {
        const { call } = await import("../lib/call");
        await call("setManualTikTok", { followers: n });
        showLast(n, new Date());
      } catch (err) { last.textContent = messageFor(err); }
      finally { btn.disabled = false; }
    });
  }

  const box = document.querySelector<HTMLElement>("[data-owner-tools]")!;
  const status = box.querySelector<HTMLElement>("[data-tiktok-status]")!;
  const result = box.querySelector<HTMLElement>("[data-growth-result]")!;
  const connect = box.querySelector<HTMLButtonElement>("[data-connect-tiktok]")!;
  const runBtn = box.querySelector<HTMLButtonElement>("[data-run-growth]")!;

  whenReady().then(async (s) => {
    if (!s.user) return;
    // The Fun Factory builder (mods and admins; the builder checks again).
    if (s.isAdmin || s.roles.includes("mod")) document.querySelector<HTMLElement>("[data-ff-link]")!.hidden = false;
    const { db, doc, getDoc, SITE_ID } = await import("../lib/db");
    const site = await getDoc(doc(db, "sites", SITE_ID));
    const isOwner = site.get("ownerUid") === s.user.uid;
    if (isOwner || s.isAdmin) manualTikTok(db, doc, getDoc, SITE_ID);
    if (!isOwner) return;
    box.hidden = false;
    const { call } = await import("../lib/call");
    try {
      const st = await call<{ configured: boolean; connected: boolean }>("tiktokStatus");
      const justConnected = new URLSearchParams(location.search).get("tiktok") === "connected";
      if (!tiktokReady() || !st.configured) { connect.disabled = true; status.textContent = "TikTok: waiting for TikTok to approve the app (its client key and secret aren't set yet). The collector skips TikTok until then."; }
      else if (st.connected) { connect.textContent = "Reconnect TikTok"; status.textContent = justConnected ? "TikTok connected. The next run will collect it." : "TikTok is connected."; }
      else status.textContent = "TikTok isn't connected yet.";
    } catch (err) { status.textContent = messageFor(err); }
    connect.addEventListener("click", () => startTikTok());
    runBtn.addEventListener("click", async () => {
      runBtn.disabled = true; result.textContent = "Collecting…";
      try {
        const r = await call<{ day: string; summary: Record<string, any>; errors: { platform: string; message: string }[]; tiktok: string }>("runGrowthCollectorNow");
        const tw = r.summary.twitch?.followers, yt = r.summary.youtube?.subscribers;
        result.textContent = `Collected ${r.day}: Twitch ${tw ?? "—"} followers, YouTube ${yt ?? "—"} subscribers, TikTok ${r.tiktok}.` + (r.errors.length ? ` Errors: ${r.errors.map((e) => `${e.platform} (${e.message})`).join("; ")}` : "");
      } catch (err) { result.textContent = messageFor(err); }
      finally { runBtn.disabled = false; }
    });
  });
</script>
