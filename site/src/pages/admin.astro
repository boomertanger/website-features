---
// Admin tools (the green header link and the avatar menu's Admin tools). The admin
// member view with role controls is milestone 2b (docs/specs/accounts.md "Later").
// The owner also gets the growth collector's tools (docs/specs/growth-collector.md):
// Connect TikTok and Run the collector now. Admins get the Trophy Room's Award a badge card
// (docs/specs/rewards.md §10; scripts/admin/award.ts).
import BaseLayout from "../layouts/BaseLayout.astro";
import ComingSoon from "../components/ComingSoon.astro";
import TrophyOrder from "../components/trophies/TrophyOrder.astro";
import "../styles/feature-lab.css";   // the Feature Lab card (.fl-admin-card)
import "../styles/bug-zapper.css";    // the Bug Zapper card (.bz-admin-card)
import "../styles/cloud-stash.css";   // the Cloud Stash card (.cs-admin-card)
import "../styles/broken-links.css";  // the Broken links card (.bl-admin-card; docs/specs/not-found.md)
import "../styles/creator-climb.css";
import "../styles/traffic-pulse.css";  // the Traffic Pulse card (.tp-acard; docs/specs/traffic-pulse.md §2) // the Creator Climb card (.cc-admin; docs/specs/creator-climb.md §7)
import Mascot from "../components/Mascot.astro";
import { SHIELD_ICON } from "../../../shared/ui/admin-menu.js";
---
<BaseLayout title="Admin tools" noindex>
  <ComingSoon title="Admin tools" lead="Member management and role controls.">
    The admin member view (member list, member detail with role controls) arrives in milestone 2b. Roles can be set with the setMemberRole function until then.
  </ComingSoon>
  <div class="bt-zone bt-when-admin">
    <a class="bt-card bt-card--door" href="/admin/goals">
      <div class="bt-card-head"><h2 class="bt-card-title">Goal Tracker</h2><span class="bt-badge bt-badge--gray">Admins</span></div>
      <p class="bt-section-text">Edit the plan to become Content Creator of the Year, track the relaunch, and publish it to /goals.</p>
    </a>
  </div>
  <div class="bt-zone bt-when-admin">
    <a class="bt-card bt-card--door" href="/admin/crew">
      <div class="bt-card-head"><h2 class="bt-card-title">Crew</h2><span class="bt-badge bt-badge--gray">Admins</span></div>
      <p class="bt-section-text">The Mod Machina roster, coverage map, promotions, queue decisions, to-do list and crew settings.</p>
    </a>
  </div>
  <div class="bt-zone" data-pulse-card hidden>
    <div class="bt-card tp-acard">
      <div class="bt-card-head"><h2 class="bt-card-title">Traffic Pulse</h2><span class="bt-badge bt-badge--admin">Admins</span></div>
      <div data-pulse-body><div class="bt-skeleton" style="height:44px"></div></div>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin bt-btn--sm" href="/admin/pulse">Open Traffic Pulse</a></div>
    </div>
  </div>
  <div class="bt-zone" data-climb-card hidden>
    <div class="cc-admin">
      <div class="cc-adm-hero">
        <div class="cc-adm-ridge" data-cca-ridge aria-hidden="true"></div>
        <div class="cc-adm-hero-t"><h2 class="bt-card-title">Creator Climb</h2><p>Runs itself every morning. Everything here is optional, and every change is logged.</p></div>
        <span class="bt-badge bt-badge--admin">Admins</span>
      </div>
      <div class="cc-adm-grid">
        <section class="bt-admin-panel" aria-labelledby="cca-readings">
          <div class="cc-row"><h3 class="bt-card-title" id="cca-readings">Readings</h3><span class="cc-sp"></span><button type="button" class="bt-btn bt-btn--admin bt-btn--sm" data-cca-rebuild>Rebuild now</button></div>
          <ul class="cc-srcs" data-cca-srcs><li><div class="bt-skeleton" style="height:96px;width:100%"></div></li></ul>
          <p class="bt-card-meta" data-cca-last></p>
        </section>
        <section class="bt-admin-panel" aria-labelledby="cca-notes">
          <h3 class="bt-card-title" id="cca-notes">Month notes</h3>
          <form class="cc-form" data-cca-notes novalidate>
            <div class="cc-fields">
              <div class="bt-field"><label class="bt-label" for="cca-month">Month</label><select class="bt-select" id="cca-month" name="month"></select></div>
              <div class="bt-field"><label class="bt-label" for="cca-likes">Live likes (optional)</label><input class="bt-input" id="cca-likes" name="likes" inputmode="numeric" autocomplete="off" placeholder="Leave empty to hide" /></div>
            </div>
            <div class="bt-field"><label class="bt-label" for="cca-hl">Highlights, one per line (optional)</label><textarea class="bt-textarea" id="cca-hl" name="highlights" rows="4" maxlength="2400"></textarea></div>
            <div class="cc-row"><span class="bt-card-meta">Milestones and records are added for you.</span><span class="cc-sp"></span><button type="submit" class="bt-btn bt-btn--admin bt-btn--sm">Save notes</button></div>
          </form>
        </section>
        <section class="bt-admin-panel" aria-labelledby="cca-eras">
          <h3 class="bt-card-title" id="cca-eras">Eras</h3>
          <form class="cc-form" data-cca-eras novalidate>
            <div class="cc-eras" data-cca-era-rows></div>
            <p class="bt-fine bt-fine--left">Leave an end empty and the era runs until the next one starts ("Until launch"), or "Now" for the last one. Back on air starts on launch day.</p>
            <div class="cc-row"><button type="button" class="bt-btn bt-btn--secondary bt-btn--sm" data-cca-era-add>Add an era</button><span class="cc-sp"></span><button type="submit" class="bt-btn bt-btn--admin bt-btn--sm">Save eras</button></div>
          </form>
        </section>
        <section class="bt-admin-panel" aria-labelledby="cca-goals">
          <h3 class="bt-card-title" id="cca-goals">Goals</h3>
          <form class="cc-form" data-cca-goals novalidate>
            <div class="cc-fields">
              <div class="bt-field"><label class="bt-label" for="cca-g-youtube">YouTube subscribers</label><input class="bt-input" id="cca-g-youtube" name="youtube" inputmode="numeric" autocomplete="off" placeholder="No goal" /></div>
              <div class="bt-field"><label class="bt-label" for="cca-g-twitch">Twitch followers</label><input class="bt-input" id="cca-g-twitch" name="twitch" inputmode="numeric" autocomplete="off" placeholder="No goal" /></div>
              <div class="bt-field"><label class="bt-label" for="cca-g-tiktok">TikTok followers</label><input class="bt-input" id="cca-g-tiktok" name="tiktok" inputmode="numeric" autocomplete="off" placeholder="No goal" /></div>
              <div class="bt-field"><label class="bt-label" for="cca-g-all">Combined</label><input class="bt-input" id="cca-g-all" name="all" inputmode="numeric" autocomplete="off" placeholder="No goal" /></div>
              <div class="bt-field"><label class="bt-label" for="cca-g-members">Members</label><input class="bt-input" id="cca-g-members" name="members" inputmode="numeric" autocomplete="off" placeholder="No goal" /></div>
            </div>
            <div class="cc-row"><span class="bt-card-meta">The YouTube goal is shared with the footer.</span><span class="cc-sp"></span><button type="submit" class="bt-btn bt-btn--admin bt-btn--sm">Save goals</button></div>
          </form>
        </section>
        <section class="bt-admin-panel" aria-labelledby="cca-left">
          <h3 class="bt-card-title" id="cca-left">Left out of member counts</h3>
          <p class="bt-card-meta">The owner is always left out. Changes apply from the next reading.</p>
          <ul class="cc-left" data-cca-left></ul>
          <form class="cc-row" data-cca-left-form novalidate>
            <input class="bt-input cc-left-in" name="handle" aria-label="Handle to leave out" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="21" placeholder="@handle" />
            <button type="submit" class="bt-btn bt-btn--admin bt-btn--sm">Leave out</button>
          </form>
        </section>
        <section class="bt-admin-panel cc-adm-wide" aria-labelledby="cca-corr">
          <div class="cc-row"><h3 class="bt-card-title" id="cca-corr">Corrections</h3><span class="cc-sp"></span><button type="button" class="bt-btn bt-btn--admin bt-btn--sm" data-cca-corr-add aria-expanded="false" aria-controls="cca-corr-form">Add a correction</button></div>
          <div class="cc-adm-empty" data-cca-corr-empty hidden><Mascot decorative /><p>No corrections. If a platform ever reports a wrong number, replace it here with a reason. The original stays in the log.</p></div>
          <form class="cc-fields" id="cca-corr-form" data-cca-corr-form novalidate hidden>
            <div class="bt-field"><label class="bt-label" for="cca-c-day">Day</label><input class="bt-input" id="cca-c-day" name="day" type="date" required /></div>
            <div class="bt-field"><label class="bt-label" for="cca-c-p">Platform</label><select class="bt-select" id="cca-c-p" name="platform"><option value="tiktok">TikTok</option><option value="twitch">Twitch</option><option value="youtube">YouTube</option></select></div>
            <div class="bt-field"><label class="bt-label" for="cca-c-v">Correct number</label><input class="bt-input" id="cca-c-v" name="value" inputmode="numeric" autocomplete="off" required /></div>
            <div class="bt-field"><label class="bt-label" for="cca-c-r">Reason (required)</label><input class="bt-input" id="cca-c-r" name="reason" maxlength="300" autocomplete="off" placeholder="What was wrong" required /></div>
            <div class="cc-row cc-adm-wide"><span class="cc-sp"></span><button type="button" class="bt-btn bt-btn--secondary bt-btn--sm" data-cca-corr-cancel>Cancel</button><button type="submit" class="bt-btn bt-btn--admin bt-btn--sm">Save correction</button></div>
          </form>
          <div data-cca-corr-list></div>
        </section>
      </div>
    </div>
  </div>
  <div class="bt-zone bt-when-admin" data-planner-card hidden>
    <div class="bt-card pc-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Scream Planner</h2><span class="bt-badge bt-badge--admin">Admins</span></div>
      <p class="bt-section-text" data-pc-deadlines></p>
      <p class="bt-fine bt-fine--left" data-pc-defaults></p>
      <p class="bt-fine bt-fine--left" data-pc-week></p>
      <div class="bt-stack" data-pc-todos hidden></div>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin" href="/schedule/plan">Plan the week</a><a class="bt-btn bt-btn--secondary" href="/schedule/plan/usual">My usual week</a></div>
    </div>
  </div>
  <div class="bt-zone" data-live-card hidden>
    <a class="bt-card bt-card--door" href="/live/control">
      <div class="bt-card-head"><h2 class="bt-card-title">Control Room</h2><span class="bt-badge bt-badge--admin">Owner and Overseers</span></div>
      <p class="bt-section-text">Start and stop the stream, run the beats and check-ins, switch games, and set the house look. The owner also keeps the private checklist here.</p>
    </a>
  </div>
  <div class="bt-zone" data-lab-card hidden>
    <div class="bt-card fl-admin-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Feature Lab</h2><span class="bt-badge bt-badge--admin">Admins</span></div>
      <div class="fl-admin-n"><span class="n" data-lab-n>…</span><span class="bt-meta" data-lab-what>new ideas waiting for a look</span></div>
      <p class="bt-meta fl-admin-oldest" data-lab-oldest></p>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin bt-btn--sm" href="/feature-lab">Open the board</a></div>
    </div>
  </div>
  <div class="bt-zone" data-bugs-card hidden>
    <div class="bt-card bz-admin-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Bug Zapper</h2><span class="bt-badge bt-badge--admin">Admins</span></div>
      <div data-bugs-body>
        <div class="bz-big-n"><b data-bugs-n>…</b><span class="bt-meta" data-bugs-what>new reports waiting for a look</span><span data-bugs-crit></span></div>
        <div class="bz-oldest" data-bugs-oldest></div>
      </div>
      <div class="bt-empty bt-empty--compact" data-bugs-clear hidden><p class="bt-empty-title">No reports waiting</p><p>Every report has had a look.</p></div>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin bt-btn--sm" href="/bug-zapper">Open the board</a></div>
    </div>
  </div>
  <div class="bt-zone" data-playbook-card hidden>
    <div class="bt-card bz-admin-card">
      <div class="bt-card-head"><h2 class="bt-card-title">The Playbook</h2><span class="bt-badge bt-badge--admin">Owner only</span></div>
      <div class="bz-big-n"><b data-pb-n>…</b><span class="bt-meta" data-pb-what>pages reviewed</span></div>
      <p class="bt-fine bt-fine--left" data-pb-lead></p>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin bt-btn--sm" href="/admin/playbook">Open the Playbook</a></div>
    </div>
  </div>
  <div class="bt-zone" data-hotline-card hidden>
    <div class="bt-card bz-admin-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Hotline Boom</h2><span class="bt-badge bt-badge--admin">Inbox team</span></div>
      <div class="bz-big-n"><b data-hb-n>…</b><span class="bt-meta" data-hb-what>new messages waiting</span></div>
      <p class="bt-fine bt-fine--left" data-hb-lead></p>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin bt-btn--sm" href="/admin/inbox">Open the inbox</a><a class="bt-btn bt-btn--ghost bt-btn--sm" href="/admin/inbox/how-it-works">How it works</a></div>
    </div>
  </div>
  <div class="bt-zone" data-kw-card hidden>
    <div class="bt-card bz-admin-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Kind words</h2><span class="bt-badge bt-badge--admin">Admins</span></div>
      <div class="bz-big-n"><b data-kw-n>…</b><span class="bt-meta" data-kw-what>postcards and notes waiting for a read</span></div>
      <p class="bt-fine bt-fine--left">Puffin Post (Newfoundland), Paw Notes (Skipper) and Notes for Boomer (Mail Call) on Base Camp. Nothing goes up until it has been read.</p>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin bt-btn--sm" href="/admin/kind-words">Read them</a></div>
    </div>
  </div>
  <div class="bt-zone" data-skipcam-card hidden>
    <div class="bt-admin-panel">
      <div class="bt-card-head"><div><span class="bt-admin-tag"><Fragment set:html={SHIELD_ICON} />Owner only</span><h2 class="bt-card-title">Skipper Cam</h2></div><span class="bt-badge bt-badge--gray" data-sc-chip>Off duty</span></div>
      <div class="bt-field">
        <label class="bt-label" for="sc-id">YouTube video id (unlisted live stream)</label>
        <input class="bt-input" id="sc-id" data-sc-id autocomplete="off" spellcheck="false" placeholder="e.g. dQw4w9WgXcQ, or paste the link" aria-describedby="sc-id-hint" />
        <p class="bt-fine bt-fine--left" id="sc-id-hint">Only signed-in Fan Club members are handed this id, and only while it's live. It never appears on the public page.</p>
      </div>
      <fieldset class="bt-field bt-stack">
        <legend class="bt-label">Before going live</legend>
        <label class="bt-check"><input type="checkbox" data-sc-check /> The sound is off on the camera and the stream</label>
        <label class="bt-check"><input type="checkbox" data-sc-check /> No screens, mail or papers with private details are in frame</label>
        <label class="bt-check"><input type="checkbox" data-sc-check /> Nothing out the window shows where we live, and nobody's in frame who hasn't agreed</label>
      </fieldset>
      <div class="bt-row-center"><button type="button" class="bt-btn bt-btn--admin" data-sc-go disabled>Go live</button><button type="button" class="bt-btn bt-btn--secondary" data-sc-off hidden>Turn it off</button></div>
      <p class="bt-fine" data-sc-last role="status"></p>
    </div>
  </div>
  <div class="bt-zone" data-stash-card hidden>
    <div class="bt-card cs-admin-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Cloud Stash</h2><span class="bt-badge bt-badge--admin">Admins</span></div>
      <div data-stash-body><div class="bt-skeleton" style="height:44px"></div></div>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin bt-btn--sm" href="/admin/stash">Open Cloud Stash</a></div>
    </div>
  </div>
  <div class="bt-zone" data-services-card hidden>
    <div class="bt-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Service Hub</h2><span class="bt-badge bt-badge--admin">Admins</span></div>
      <div class="bt-stack" data-services-body><div class="bt-skeleton" style="height:44px"></div></div>
      <div class="bt-row-center"><a class="bt-btn bt-btn--admin bt-btn--sm" href="/admin/services">Open the Service Hub</a></div>
    </div>
  </div>
  <div class="bt-zone" data-bl-card hidden>
    <div class="bt-admin-panel bl-admin-card">
      <div class="bl-head"><h2 class="bt-card-title">Broken links</h2><span class="bt-admin-tag"><Fragment set:html={SHIELD_ICON} />Admin only</span></div>
      <p class="bt-meta">Addresses people reported from the 404 page, most reported first. Fix or redirect them (public/_redirects), then mark them fixed.</p>
      <div data-bl-body><div class="bt-skeleton" style="height:44px"></div></div>
      <div class="bt-empty bt-empty--compact bl-empty" data-bl-empty hidden><Mascot decorative /><p class="bt-empty-title">No broken links reported.</p></div>
    </div>
  </div>
  <div class="bt-zone" data-ff-link hidden>
    <a class="bt-card bt-card--door" href="/shift/builder">
      <div class="bt-card-head"><h2 class="bt-card-title">Night Shift builder</h2><span class="bt-badge bt-badge--teal">Mods and admins</span></div>
      <p class="bt-section-text">Plan seasons, review and schedule them, and manage the idea library.</p>
    </a>
  </div>
  <!-- Temporary: the TikTok count by hand until the TikTok API is approved (after launch). -->
  <div class="bt-zone" data-tiktok-manual hidden>
    <div class="bt-card">
      <div class="bt-card-head"><h2 class="bt-card-title">TikTok followers (manual)</h2><span class="bt-badge bt-badge--gray">Admins</span></div>
      <p class="bt-section-text" data-tm-connected hidden>Connected, updated automatically.</p>
      <form class="bt-stack" data-tm-form novalidate>
        <div class="bt-field">
          <label class="bt-label" for="bt-tm-n">Followers today, <span data-tm-today></span></label>
          <input class="bt-input" id="bt-tm-n" name="followers" type="number" inputmode="numeric" min="0" max="100000000" step="1" required />
        </div>
        <div class="bt-row-center"><button type="submit" class="bt-btn bt-btn--primary">Save</button></div>
        <p class="bt-fine" data-tm-last role="status"></p>
      </form>
    </div>
  </div>
  <div class="bt-zone" data-award hidden>
    <div class="bt-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Award a badge</h2><span class="bt-badge bt-badge--gray">Admins</span></div>
      <p class="bt-section-text">Give a member a crew-awarded badge, or take one back. Every award and revoke needs a reason, is logged, and adds or removes the badge's XP. You can't award yourself, and you can award 20 a day.</p>
      <form class="bt-stack" data-award-form novalidate>
        <div class="bt-field">
          <label class="bt-label" for="aw-handle">Member's handle</label>
          <input class="bt-input" id="aw-handle" name="handle" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="21" placeholder="@handle" required aria-describedby="aw-who" />
          <p class="bt-fine bt-fine--left" id="aw-who" data-aw-who aria-live="polite"></p>
        </div>
        <div class="bt-field">
          <label class="bt-label" for="aw-badge">Badge</label>
          <select class="bt-select" id="aw-badge" name="badge" required aria-describedby="aw-badge-note" disabled><option value="">Loading badges…</option></select>
          <p class="bt-fine bt-fine--left" id="aw-badge-note" data-aw-note aria-live="polite">Each badge says who can award it. Badges members earn on their own can't be awarded.</p>
        </div>
        <div class="bt-field">
          <label class="bt-label" for="aw-reason">Reason</label>
          <textarea class="bt-textarea" id="aw-reason" name="reason" maxlength="300" required aria-describedby="aw-count" placeholder="What did they do? The member sees this in their history."></textarea>
          <p class="bt-fine bt-fine--left" id="aw-count" data-aw-count>10 to 300 characters.</p>
        </div>
        <div class="bt-row-center">
          <button type="submit" class="bt-btn bt-btn--primary" data-aw-award>Award badge</button>
          <button type="button" class="bt-btn bt-btn--danger" data-aw-revoke>Revoke badge</button>
        </div>
      </form>
    </div>
  </div>
  <TrophyOrder />
  <div class="bt-zone" data-yt-card hidden>
    <div class="bt-card">
      <div class="bt-card-head"><h2 class="bt-card-title">YouTube events</h2><span class="bt-badge bt-badge--gray" data-yt-badge>Owner only</span></div>
      <p class="bt-section-text">Connect your YouTube channel and every published stream gets its own YouTube event, and delays and cancellations follow. Google's app must be set to In production, or the connection expires after a week. Google may warn that the app is unverified: click Advanced, then continue. You only need to do that once.</p>
      <div class="bt-row-center"><button type="button" class="bt-btn bt-btn--primary" data-yt-connect>Connect YouTube</button></div>
      <p class="bt-fine" data-yt-status role="status"></p>
    </div>
  </div>
  <div class="bt-zone" data-owner-tools hidden>
    <div class="bt-card">
      <div class="bt-card-head"><h2 class="bt-card-title">Growth collector</h2><span class="bt-badge bt-badge--gray">Owner only</span></div>
      <p class="bt-section-text">Follower and subscriber counts for the footer's Follow badges, collected every day at 5 am Pacific.</p>
      <div class="bt-row-center">
        <button type="button" class="bt-btn bt-btn--secondary" data-run-growth>Run the collector now</button>
        <button type="button" class="bt-btn bt-btn--primary" data-connect-tiktok>Connect TikTok</button>
      </div>
      <p class="bt-fine" data-tiktok-status role="status"></p>
      <p class="bt-fine" data-growth-result role="status"></p>
    </div>
    <div class="bt-card" data-catalog>
      <div class="bt-card-head"><h2 class="bt-card-title">Badge catalog</h2><span class="bt-badge bt-badge--gray">Owner only</span></div>
      <p class="bt-section-text">Loads the Trophy Room's badges from the site's catalog file into this site. Check shows what would be created or changed and writes nothing. Load does it. It never deletes a badge and keeps who holds what.</p>
      <div class="bt-row-center">
        <button type="button" class="bt-btn bt-btn--admin" data-cat-check>Check</button>
        <button type="button" class="bt-btn bt-btn--admin" data-cat-load>Load</button>
      </div>
      <p class="bt-fine" data-cat-status role="status"></p>
      <div class="bt-tags" data-cat-ids hidden></div>
    </div>
  </div>
</BaseLayout>

<script>
  // Owner and admin checks are for display only: the callables check on the server.
  import "../scripts/admin/award";
  import "../scripts/admin/planner-card";
  import "../scripts/admin/live-card";
  import "../scripts/admin/lab-card";
  import "../scripts/admin/bugs-card";
  import "../scripts/admin/hotline-card";
  import "../scripts/admin/playbook-card";
  import "../scripts/admin/kind-words-card";
  import "../scripts/admin/skipper-cam-card";
  import "../scripts/admin/stash-card";
  import "../scripts/admin/services-card";
  import "../scripts/admin/broken-links-card";
  import "../scripts/admin/climb-card";
  import "../scripts/admin/pulse-card";
  import { initYouTube } from "../scripts/admin/youtube-card";
  import { whenReady } from "../lib/auth";
  import { messageFor } from "../lib/errors";
  import { startTikTok, tiktokReady } from "../lib/tiktok";
  import { confirmAction } from "../../../shared/ui/confirm.js";

  // ---- TikTok followers (manual), until the API is approved (docs/specs/growth-collector.md §5b) ----
  const DAY_MS = 86400000;
  const laDate = (d = new Date()) => new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", weekday: "short", month: "short", day: "numeric", year: "numeric" }).format(d);
  async function manualTikTok(db: any, doc: any, getDoc: any, SITE_ID: string) {
    const card = document.querySelector<HTMLElement>("[data-tiktok-manual]")!;
    const form = card.querySelector<HTMLFormElement>("[data-tm-form]")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const last = form.querySelector<HTMLElement>("[data-tm-last]")!;
    card.querySelector<HTMLElement>("[data-tm-today]")!.textContent = laDate();
    card.hidden = false;
    const showLast = (followers: number | null, at: Date | null) => {
      if (followers == null || !at) { last.textContent = "No count saved yet. The footer shows Follow until there is one."; return; }
      const days = Math.floor((Date.now() - at.getTime()) / DAY_MS);
      const when = days <= 0 ? "today" : days === 1 ? "1 day ago" : `${days} days ago`;
      last.textContent = `Last saved ${when}: ${followers.toLocaleString("en-US")} followers.`
        + (days >= 7 ? " The footer now shows Follow instead of the count (older than 7 days). Save today's count to bring it back."
          : days > 5 ? " Reminder: update it soon; the footer hides counts older than 7 days." : "");
    };
    const socials = await getDoc(doc(db, "sites", SITE_ID, "public", "socials"));
    const tt = socials.exists() ? socials.get("tiktok") : null;
    if (tt?.source === "api") {
      form.hidden = true;
      card.querySelector<HTMLElement>("[data-tm-connected]")!.hidden = false;
      return;
    }
    if (typeof tt?.followers === "number") input.value = String(tt.followers);
    showLast(tt?.followers ?? null, tt?.updatedAt?.toDate?.() ?? null);
    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const n = Number(input.value);
      if (input.value === "" || !Number.isInteger(n) || n < 0 || n > 100000000) { last.textContent = "Enter a whole number from 0 to 100,000,000."; input.focus(); return; }
      const btn = form.querySelector<HTMLButtonElement>("button")!;
      btn.disabled = true;
      try {
        const { call } = await import("../lib/call");
        await call("setManualTikTok", { followers: n });
        showLast(n, new Date());
      } catch (err) { last.textContent = messageFor(err); }
      finally { btn.disabled = false; }
    });
  }

  const box = document.querySelector<HTMLElement>("[data-owner-tools]")!;
  const status = box.querySelector<HTMLElement>("[data-tiktok-status]")!;
  const result = box.querySelector<HTMLElement>("[data-growth-result]")!;
  const connect = box.querySelector<HTMLButtonElement>("[data-connect-tiktok]")!;
  const runBtn = box.querySelector<HTMLButtonElement>("[data-run-growth]")!;

  // ---- Badge catalog (owner only; seedBadgeCatalog checks again on the server) ----
  type CatalogResult = { apply: boolean; written: number; total: number; created: string[]; changed: { id: string; fields: string[] }[]; unchanged: number; extra: string[]; collections: { created: number; changed: number } };
  const cat = document.querySelector<HTMLElement>("[data-catalog]")!;
  const catStatus = cat.querySelector<HTMLElement>("[data-cat-status]")!;
  const catIds = cat.querySelector<HTMLElement>("[data-cat-ids]")!;
  const catBtns = [...cat.querySelectorAll<HTMLButtonElement>("button")];
  const plural = (n: number, one: string, many = one + "s") => `${n} ${n === 1 ? one : many}`;
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  function showCatalog(r: CatalogResult) {
    const cols = r.collections.created + r.collections.changed;
    const head = r.apply ? "Loaded" : "Check";
    const verb = r.apply ? ["created", "changed"] : ["would be created", "would be changed"];
    catStatus.textContent = `${head}: ${r.total} badges in the catalog file. ${plural(r.created.length, "badge")} ${verb[0]}, ${plural(r.changed.length, "badge")} ${verb[1]}, ${r.unchanged} already match.`
      + (cols ? ` ${plural(cols, "collection")} ${r.apply ? "updated" : "to update"}.` : "")
      + (r.extra.length ? ` Left alone (in the site but not in the file): ${r.extra.join(", ")}.` : "")
      + (r.apply ? ` ${plural(r.written, "document")} written.` : r.created.length || r.changed.length ? " Nothing has been written yet." : " Nothing to load.");
    const chips = [...r.created.map((id) => `<span class="bt-tag">${esc(id)}</span>`), ...r.changed.map((c) => `<span class="bt-tag">${esc(c.id)} (${esc(c.fields.join(", "))})</span>`)];
    catIds.innerHTML = chips.join("");
    catIds.hidden = !chips.length;
  }
  async function runCatalog(apply: boolean) {
    const { call } = await import("../lib/call");
    return call<CatalogResult>("seedBadgeCatalog", { apply });
  }
  cat.querySelector<HTMLButtonElement>("[data-cat-check]")!.addEventListener("click", async () => {
    catBtns.forEach((b) => (b.disabled = true)); catStatus.textContent = "Checking…";
    try { showCatalog(await runCatalog(false)); } catch (err) { catStatus.textContent = messageFor(err); catIds.hidden = true; }
    finally { catBtns.forEach((b) => (b.disabled = false)); }
  });
  cat.querySelector<HTMLButtonElement>("[data-cat-load]")!.addEventListener("click", () => {
    void confirmAction({
      title: "Load the badge catalog?",
      message: "This creates the badges that are missing and updates the ones whose definition changed in the catalog file. It never deletes a badge, and it keeps who holds each one. Use Check first to see the list.",
      confirmLabel: "Load",
      busyLabel: "Loading…",
      danger: false,
      onConfirm: async () => {
        try { showCatalog(await runCatalog(true)); } catch (err) { throw new Error(messageFor(err)); }
      },
    });
  });

  whenReady().then(async (s) => {
    if (!s.user) return;
    // Night Shift builder (mods and admins; the builder checks again).
    if (s.isAdmin || s.roles.includes("mod")) document.querySelector<HTMLElement>("[data-ff-link]")!.hidden = false;
    const { db, doc, getDoc, SITE_ID } = await import("../lib/db");
    const site = await getDoc(doc(db, "sites", SITE_ID));
    const isOwner = site.get("ownerUid") === s.user.uid;
    if (isOwner || s.isAdmin) manualTikTok(db, doc, getDoc, SITE_ID);
    if (!isOwner) return;
    box.hidden = false;
    void initYouTube();
    const { call } = await import("../lib/call");
    try {
      const st = await call<{ configured: boolean; connected: boolean }>("tiktokStatus");
      const justConnected = new URLSearchParams(location.search).get("tiktok") === "connected";
      if (!tiktokReady() || !st.configured) { connect.disabled = true; status.textContent = "TikTok: waiting for TikTok to approve the app (its client key and secret aren't set yet). The collector skips TikTok until then."; }
      else if (st.connected) { connect.textContent = "Reconnect TikTok"; status.textContent = justConnected ? "TikTok connected. The next run will collect it." : "TikTok is connected."; }
      else status.textContent = "TikTok isn't connected yet.";
    } catch (err) { status.textContent = messageFor(err); }
    connect.addEventListener("click", () => startTikTok());
    runBtn.addEventListener("click", async () => {
      runBtn.disabled = true; result.textContent = "Collecting…";
      try {
        const r = await call<{ day: string; summary: Record<string, any>; errors: { platform: string; message: string }[]; tiktok: string }>("runGrowthCollectorNow");
        const tw = r.summary.twitch?.followers, yt = r.summary.youtube?.subscribers;
        result.textContent = `Collected ${r.day}: Twitch ${tw ?? "—"} followers, YouTube ${yt ?? "—"} subscribers, TikTok ${r.tiktok}.` + (r.errors.length ? ` Errors: ${r.errors.map((e) => `${e.platform} (${e.message})`).join("; ")}` : "");
      } catch (err) { result.textContent = messageFor(err); }
      finally { runBtn.disabled = false; }
    });
  });
</script>

<style is:global>
  .bt-root:not(#_) .pc-card { display: flex; flex-direction: column; gap: 10px; border-color: var(--bt-admin-panel-border); background: var(--bt-admin-panel-bg); }
  .bt-root:not(#_) .pc-card .bt-card-title { color: var(--bt-admin-text); }
  .bt-root:not(#_) .pc-card > p { margin: 0; }
  .bt-root:not(#_) .pc-card .bt-row-center { margin-top: 4px; }
</style>
