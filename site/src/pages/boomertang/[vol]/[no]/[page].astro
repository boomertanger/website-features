---
// /boomertang/vol-<v>/no-<n>/<page>: an issue's pages (docs/specs/boomertang.md §2, §4, §6): the contents, then each contents row. A public
// issue's pages (text in the repo) are rendered here into static HTML by the shared renderer (lib/boomertang/render.js). A members-only
// issue's page ships as the sealed shell (L2: its cover taped shut, the public headline and dek, the lock card, the other pages with locks);
// scripts/boomertang/issue.ts reads the text from Firestore (the rules decide) and renders it with the same renderer when this reader may.
// No member text is ever in the page. A page dropped in a later edition (issues.json "dropped") redirects to the issue's contents.
import IssueShell from "../../../../components/boomertang/IssueShell.astro";
import Mascot from "../../../../components/Mascot.astro";
import { BUILT, pageFile, pageHref, sourcesOf, type Issue } from "../../../../lib/boomertang/issues";
import { renderPage, pageHeadHtml, parsePage } from "../../../../lib/boomertang/render.js";
import { thumbHtml } from "../../../../lib/boomertang/cover.js";
import { LOCK_ICON } from "../../../../../../shared/ui/magazine.js";
import "../../../../styles/boomertang.css";

export function getStaticPaths() {
  const out = [];
  for (const issue of BUILT) {
    const params = (page: string) => ({ vol: `vol-${issue.vol}`, no: `no-${issue.no}`, page });
    out.push({ params: params("contents"), props: { issue, slug: "contents", dropped: false } });
    for (const r of issue.contents) out.push({ params: params(r.page), props: { issue, slug: r.page, dropped: false } });
    for (const d of issue.dropped || []) out.push({ params: params(d), props: { issue, slug: d, dropped: true } });
  }
  return out;
}
const { issue, slug, dropped } = Astro.props as { issue: Issue; slug: string; dropped: boolean };
const contentsHref = pageHref(issue, "contents");
const row = issue.contents.find((r) => r.page === slug);
const ctx = { issue, sources: sourcesOf(issue), hrefFor: (s: string) => pageHref(issue, s) };
const file = issue.textInRepo ? pageFile(issue, slug) : null;
const page = file ? renderPage(file, ctx) : null;
const meta = page?.meta || (file ? parsePage(file).meta : {});
const membersOnly = !issue.textInRepo;
const isContents = slug === "contents";
const title = isContents ? `Contents · ${issue.title}` : `${row?.title || slug} · Boomertang No. ${issue.no}`;
const description = isContents ? issue.about : row?.line || issue.about;
const dark = !!meta.wide;
const others = issue.contents.filter((r) => r.page !== slug);
// the contents page: the letter (public issues: from contents.md; members-only: from Firestore) and the rows
const letter = isContents && page ? page.html : "";
---
{dropped ? (
  <html lang="en"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=${contentsHref}`} /><link rel="canonical" href={contentsHref} /><meta name="robots" content="noindex" /><title>Moved</title></head><body><a href={contentsHref}>This page moved to the issue's contents.</a></body></html>
) : (
<IssueShell issue={issue} slug={slug} title={title} description={description} dark={dark} folio={meta.folio || (isContents ? issue.title : row?.kind || "")} membersOnly={membersOnly && !isContents} wide={dark}>
  {isContents ? (
    <div class="tg-toc">
      <div>
        <div class="tg-toc-photo"><span class="tg-art" aria-hidden="true"></span>{meta.photoLine && <span>{meta.photoLine}</span>}</div>
        <div class="tg-letter" data-tang-letter hidden={!letter}>
          <Mascot decorative />
          <div><span class="tg-kicker">{meta.letterKicker || "From the editor"}</span><div data-tang-letter-body set:html={letter} /><div class="sig">{meta.signature || "Boomer"}</div></div>
        </div>
      </div>
      <div>
        <span class="tg-kicker">{meta.kicker || "In this issue"}</span>
        <h1 class="tg-hed" set:html={(meta.hed || issue.title).replace(/\*([^*]+)\*/g, "<em>$1</em>")} />
        <ol class="tg-tocl">
          {issue.contents.map((r) => (
            <li><a class="tg-tocrow" href={pageHref(issue, r.page)} data-page-link={r.page}><span class="n">{r.n}</span><span class="t"><b>{r.title}<span class="tg-lockmark" data-lock={r.page} hidden={!membersOnly} set:html={LOCK_ICON} /></b><span>{r.line}</span></span><span class="k">{r.kind}</span></a></li>
          ))}
        </ol>
      </div>
    </div>
  ) : page ? (
    <article class:list={["tg-article", `tg-article--${slug}`]}>
      <Fragment set:html={pageHeadHtml(meta, { bignum: meta.hedStyle === "bignum" })} />
      <Fragment set:html={page.html} />
    </article>
  ) : (
    <>
      <section class="tg-sealed" data-sealed>
        <div class="tg-sealcover"><Fragment set:html={thumbHtml(issue, { locked: true })} /><span class="tg-tape">Members only</span></div>
        <div>
          <span class="tg-kicker">You opened {row?.kind === "Cover story" ? "the cover story" : row?.nav}</span>
          <h1 class="tg-hed">{row?.title}</h1>
          <p class="tg-dek">{row?.line}</p>
          <div class="tg-lockstack" data-lockcard>
            <div class="bt-lock-card"><span class="bt-lock-card-ic" aria-hidden="true">🔒</span><div><b>Members only</b><p>Checking whether this page is open for you…</p></div></div>
          </div>
          <div class="tg-also">
            <h2 class="tg-also-h">Also in No. {issue.no}</h2>
            <ol class="tg-tocl tg-tocl--small">{others.map((r) => <li><a class="tg-tocrow" href={pageHref(issue, r.page)}><span class="n">{r.n}</span><span class="t"><b>{r.title}<span class="tg-lockmark" data-lock={r.page} set:html={LOCK_ICON} /></b></span><span class="k">{r.kind}</span></a></li>)}</ol>
          </div>
        </div>
      </section>
      <article class="tg-article" data-tang-body hidden></article>
    </>
  )}
</IssueShell>
)}
